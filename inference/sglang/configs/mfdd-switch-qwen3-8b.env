# MFD-D drafter (8 modes + default path) on Qwen3-8B: per-batch-size tree configuration (see mfdd-switch-qwen3-4b.env):
#   batch 1-2    8-mode mixture, B = 63
#   batch 3-5    default path, B = 31
#   batch 6-23   default path, B = 15
#   batch >= 24  default path, B = 7
# Measured (full-data MFD-D drafter, T=0 and T=1): within -3.1% to 0.0% of the best fixed engine at every batch
# size 1-32 (docs/SGLANG.md).
MFD_ENGINE_MODE=ddtree
SGLANG_DFLASH_DDTREE_BUDGET=63
SGLANG_DFLASH_DDTREE_NUM_MODES=8
SGLANG_DFLASH_DDTREE_DEFAULT_MODE=1
SGLANG_DFLASH_DDTREE_SWITCH=2:63,3:31:8,6:15:8,24:7:8
