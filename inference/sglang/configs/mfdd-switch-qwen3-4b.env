# MFD-D drafter (8 modes + default path) on Qwen3-4B: one engine whose tree depends on the decode batch size
# (SGLANG_DFLASH_DDTREE_SWITCH = min_bs:budget[:branches], each tier with its own CUDA graphs):
#   batch 1      8-mode mixture, B = 63
#   batch 2      8-mode mixture, B = 31
#   batch 3-23   default path (branch index 8 = the drafter without a mode embedding), B = 15
#   batch >= 24  default path, B = 7
# Measured (full-data MFD-D drafter, T=0 and T=1): within -2.5% to +0.9% of the best fixed engine at every batch
# size 1-32 (docs/SGLANG.md).
MFD_ENGINE_MODE=ddtree
SGLANG_DFLASH_DDTREE_BUDGET=63
SGLANG_DFLASH_DDTREE_NUM_MODES=8
SGLANG_DFLASH_DDTREE_DEFAULT_MODE=1
SGLANG_DFLASH_DDTREE_SWITCH=2:31,3:15:8,24:7:8
