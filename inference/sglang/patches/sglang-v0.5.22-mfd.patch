@@ -0,0 +1,916 @@
+"""DDTree (tree-verified DFlash) helpers for DFlashWorkerV2.
+
+MFD / DDTree patch for SGLang v0.5.22. Behaviour follows the HF reference of the MFD release
+(inference/hf/ddtree.py, ``ddtree_generate`` with ``--tree-impl fast``):
+
+* The DFlash drafter outputs one distribution per future position (block of
+  ``block_size`` positions: the last verified token + ``block_size - 1`` masks).
+* The tree holds the ``B`` prefixes with the largest sum of per-position log-probs
+  (best-first heap, prefix-closed). Top-k candidates (k = min(B, V)) and their
+  log-probabilities come from the bf16 draft logits (top-k on bf16, log Z in fp32),
+  as ``tree_logits.top_candidates``; the heap is the C++ builder of
+  ``tree_build_ext.py`` (same pop order and tie-breaks), run on the host.
+* Multi-mode (MFD) drafts: score of a prefix = max over modes of (log prior + sum
+  of the mode's per-position log-probs); one merged heap over the K per-mode
+  searches; a prefix popped again from another mode reuses its node.
+* The target verifies the root + B nodes in one TARGET_VERIFY forward with an
+  ancestor-only tree attention mask; acceptance follows the target's own token at
+  each node (argmax at T=0, a sample at T>0), so the output is lossless.
+
+Enable with ``SGLANG_DFLASH_DDTREE_BUDGET=B`` (B > 0) together with
+``--speculative-algorithm DFLASH``; ``speculative_num_draft_tokens`` then becomes the
+verify width ``B + 1`` (set automatically) while the draft block keeps the draft
+config's block size.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+from typing import Optional
+
+import msgspec
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+
+
+# --------------------------------------------------------------------------- config
+
+
+class DDTreeProfile(msgspec.Struct, frozen=True):
+    """A tree configuration: budget B over ``num_modes`` drafted branches (``mode_subset``: their indices
+    in a multi-mode draft, MODE_SUBSET indexing; empty = all of the draft's modes), for decode batches
+    of at least ``min_bs`` requests (up to the next profile's)."""
+
+    budget: int
+    num_modes: int
+    mode_subset: tuple[int, ...] = ()
+    min_bs: int = 1
+
+    @property
+    def window_width(self) -> int:
+        """KV slots one request's round writes: the verify (B + 1) and the draft blocks (K * L)."""
+        return max(self.budget + 1, ddtree_block_size() * self.num_modes)
+
+
+# The profile whose decode graphs are being captured, while it is not the primary (env) one.
+_profile_override: Optional[DDTreeProfile] = None
+
+
+@contextlib.contextmanager
+def ddtree_profile_override(profile: DDTreeProfile):
+    """Make the config helpers below answer for ``profile`` (graph runners size and capture from them)."""
+    global _profile_override
+    previous, _profile_override = _profile_override, profile
+    try:
+        yield
+    finally:
+        _profile_override = previous
+
+
+def ddtree_profiles() -> list[DDTreeProfile]:
+    """The primary profile (BUDGET / NUM_MODES / MODE_SUBSET), then the batch-size switch's by ascending min_bs."""
+    primary = DDTreeProfile(
+        budget=int(envs.SGLANG_DFLASH_DDTREE_BUDGET.get()),
+        num_modes=int(envs.SGLANG_DFLASH_DDTREE_NUM_MODES.get()),
+        mode_subset=tuple(int(m) for m in envs.SGLANG_DFLASH_DDTREE_MODE_SUBSET.get()),
+    )
+    spec = (envs.SGLANG_DFLASH_DDTREE_SWITCH.get() or "").strip()
+    if primary.budget <= 0 or not spec:
+        return [primary]
+    profiles = [primary]
+    for entry in spec.split(","):
+        fields = entry.strip().split(":")
+        if len(fields) not in (2, 3):
+            raise ValueError(f"SGLANG_DFLASH_DDTREE_SWITCH entry {entry!r}: expected min_bs:budget[:branches].")
+        subset = tuple(int(m) for m in fields[2].split(".")) if len(fields) == 3 and fields[2] else ()
+        if not subset and primary.mode_subset:
+            raise ValueError(
+                f"SGLANG_DFLASH_DDTREE_SWITCH entry {entry!r} needs its branches when MODE_SUBSET is set "
+                "(no branches means all of the draft's modes)."
+            )
+        profiles.append(
+            DDTreeProfile(
+                budget=int(fields[1]),
+                num_modes=len(subset) or primary.num_modes,
+                mode_subset=subset,
+                min_bs=int(fields[0]),
+            )
+        )
+    min_bs = [p.min_bs for p in profiles]
+    if min_bs != sorted(set(min_bs)):
+        raise ValueError(f"SGLANG_DFLASH_DDTREE_SWITCH={spec!r}: min_bs must increase from 2.")
+    return profiles
+
+
+def ddtree_profile_capture_bs(
+    capture_bs: list[int], compile_bs: list[int]
+) -> tuple[list[int], list[int]]:
+    """Decode-graph batch sizes of the profile being captured: its own batch range, the range's top
+    included (so a batch never pads into the next profile's range)."""
+    profiles = ddtree_profiles()
+    if len(profiles) == 1:
+        return capture_bs, compile_bs
+    i = 0 if _profile_override is None else profiles.index(_profile_override)
+    lo = profiles[i].min_bs
+    hi = profiles[i + 1].min_bs - 1 if i + 1 < len(profiles) else max(capture_bs)
+    keep = {bs for bs in capture_bs if lo <= bs <= hi}
+    if hi <= max(capture_bs):
+        keep.add(hi)
+    if not keep:
+        raise ValueError(f"DDTree profile {profiles[i]} has no decode graph batch size in {capture_bs}.")
+    keep = sorted(keep)
+    return keep, [bs for bs in compile_bs if bs in keep]
+
+
+def ddtree_budget() -> int:
+    """Tree budget B (drafted nodes per round); 0 = DDTree off (plain DFLASH chain)."""
+    if _profile_override is not None:
+        return _profile_override.budget
+    return int(envs.SGLANG_DFLASH_DDTREE_BUDGET.get())
+
+
+def ddtree_enabled() -> bool:
+    return ddtree_budget() > 0
+
+
+def ddtree_block_size() -> int:
+    """Draft block size in DDTree mode (the draft runner's per-request width)."""
+    return int(envs.SGLANG_DFLASH_DDTREE_BLOCK_SIZE.get())
+
+
+def ddtree_verify_width() -> int:
+    return ddtree_budget() + 1
+
+
+def ddtree_num_modes() -> int:
+    """Draft modes per round (K mode blocks share one draft forward)."""
+    if _profile_override is not None:
+        return _profile_override.num_modes
+    return int(envs.SGLANG_DFLASH_DDTREE_NUM_MODES.get())
+
+
+def ddtree_mode_attention_impl() -> str:
+    """Attention of the multi-mode draft step: "triton" | "flashinfer" | "reference"."""
+    return str(envs.SGLANG_DFLASH_DDTREE_MODE_ATTN.get())
+
+
+def ddtree_mode_subset() -> tuple[int, ...]:
+    """Mode indices of a multi-mode draft to run (empty = all)."""
+    if _profile_override is not None:
+        return _profile_override.mode_subset
+    return tuple(int(m) for m in envs.SGLANG_DFLASH_DDTREE_MODE_SUBSET.get())
+
+
+def ddtree_draft_width() -> int:
+    """Draft tokens per request per round: one block per mode."""
+    return ddtree_block_size() * ddtree_num_modes()
+
+
+def ddtree_async_mode() -> int:
+    """0: synchronous host build; 1: CUDA host function; 2: builder thread + stream wait."""
+    return int(envs.SGLANG_DFLASH_DDTREE_ASYNC.get()) if ddtree_enabled() else 0
+
+
+def ddtree_async_enabled() -> bool:
+    return ddtree_async_mode() > 0
+
+
+def ddtree_window_width() -> int:
+    """KV slots one request's round may write, over all profiles (the scheduler reserves them per request)."""
+    return max(p.window_width for p in ddtree_profiles())
+
+
+def ddtree_draft_vocab_path() -> str:
+    """Token-id list of the reduced draft vocabulary ("" = the full vocabulary)."""
+    return str(envs.SGLANG_DFLASH_DDTREE_DRAFT_VOCAB.get() or "").strip()
+
+
+def load_draft_vocab(path: str, *, vocab_size: int) -> torch.Tensor:
+    """The draft vocabulary at ``path`` as sorted unique int64 token ids (CPU): a JSON list, a JSON object with
+    "token_ids", or whitespace-separated ids. Sorted by id, the subset keeps the full vocabulary's relative order."""
+    import json
+
+    with open(path) as f:
+        text = f.read()
+    try:
+        spec = json.loads(text)
+        ids = spec["token_ids"] if isinstance(spec, dict) else spec
+    except ValueError:
+        ids = text.split()
+    ids = sorted({int(i) for i in ids})
+    if not ids or ids[0] < 0 or ids[-1] >= vocab_size:
+        raise ValueError(
+            f"SGLANG_DFLASH_DDTREE_DRAFT_VOCAB={path!r}: token ids must lie in [0, {vocab_size}), "
+            f"got {len(ids)} ids in [{ids[0] if ids else None}, {ids[-1] if ids else None}]."
+        )
+    return torch.tensor(ids, dtype=torch.int64)
+
+
+# --------------------------------------------------------------------------- C++ tree builder
+
+_CPP_SOURCE = r"""
+#include <torch/extension.h>
+#include <cstring>
+#include <queue>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+
+// Heap orders reproduce tree_build_ext.py (and hence ddtree.build_ddtree_tree /
+// build_mixture_tree) exactly.
+struct SingleEntry {
+    double key;               // -logw
+    std::vector<int> ranks;   // rank tuple, Python tie-break
+    int parent, depth, rank;
+    double logw;
+};
+struct SingleGreater {
+    bool operator()(const SingleEntry& a, const SingleEntry& b) const {
+        if (a.key != b.key) return a.key > b.key;
+        if (a.ranks != b.ranks) return a.ranks > b.ranks;
+        if (a.parent != b.parent) return a.parent > b.parent;
+        if (a.depth != b.depth) return a.depth > b.depth;
+        if (a.rank != b.rank) return a.rank > b.rank;
+        return a.logw > b.logw;
+    }
+};
+
+struct MixEntry {
+    float key;                // -(logw + prior[mode]) in float32
+    int mode, parent, depth, rank;
+    double logw;              // excludes the prior
+};
+struct MixGreater {
+    bool operator()(const MixEntry& a, const MixEntry& b) const {
+        if (a.key != b.key) return a.key > b.key;
+        if (a.mode != b.mode) return a.mode > b.mode;
+        if (a.parent != b.parent) return a.parent > b.parent;
+        if (a.depth != b.depth) return a.depth > b.depth;
+        if (a.rank != b.rank) return a.rank > b.rank;
+        return a.logw > b.logw;
+    }
+};
+
+// One tree. lp/ids: [L, k]. Writes tokens[1..n], depths[1..n], parents[0..n] (node 0 = root,
+// parents[0] = -1, depths[0] = 0); returns n.
+int64_t build_single_one(const float* lp, const int32_t* ids, int64_t depth_limit, int64_t topk, int64_t budget,
+                         int64_t* tokens, int64_t* depths, int64_t* parents) {
+    std::priority_queue<SingleEntry, std::vector<SingleEntry>, SingleGreater> heap;
+    const double first = static_cast<double>(lp[0]);
+    heap.push(SingleEntry{-first, {0}, 0, 1, 0, first});
+    parents[0] = -1;
+    depths[0] = 0;
+    int64_t count = 0;
+    while (!heap.empty() && count < budget) {
+        SingleEntry e = heap.top();
+        heap.pop();
+        const int64_t token = ids[(e.depth - 1) * topk + e.rank];
+        const int64_t current = count + 1;
+        tokens[current] = token;
+        depths[current] = e.depth;
+        parents[current] = e.parent;
+        ++count;
+        if (e.rank + 1 < topk) {
+            std::vector<int> r = e.ranks;
+            r.back() = e.rank + 1;
+            const double lw = e.logw - static_cast<double>(lp[(e.depth - 1) * topk + e.rank])
+                              + static_cast<double>(lp[(e.depth - 1) * topk + e.rank + 1]);
+            heap.push(SingleEntry{-lw, std::move(r), e.parent, e.depth, e.rank + 1, lw});
+        }
+        if (e.depth < depth_limit) {
+            std::vector<int> r = e.ranks;
+            r.push_back(0);
+            const double lw = e.logw + static_cast<double>(lp[e.depth * topk]);
+            heap.push(SingleEntry{-lw, std::move(r), static_cast<int>(current), e.depth + 1, 0, lw});
+        }
+    }
+    return count;
+}
+
+// One mixture tree. lp/ids: [K, L, k], prior: [K].
+int64_t build_mixture_one(const float* lp, const int32_t* ids, const float* prior, int64_t num_modes,
+                          int64_t depth_limit, int64_t topk, int64_t budget,
+                          int64_t* tokens, int64_t* depths, int64_t* parents) {
+    auto at = [&](int64_t mode, int64_t d, int64_t r) { return (mode * depth_limit + d) * topk + r; };
+    auto key = [&](double logw, int64_t mode) { return -(static_cast<float>(logw) + prior[mode]); };
+    std::priority_queue<MixEntry, std::vector<MixEntry>, MixGreater> heap;
+    for (int64_t mode = 0; mode < num_modes; ++mode) {
+        const double lw = static_cast<double>(lp[at(mode, 0, 0)]);
+        heap.push(MixEntry{key(lw, mode), static_cast<int>(mode), 0, 1, 0, lw});
+    }
+    std::vector<std::unordered_map<int64_t, int64_t>> child_maps(1);
+    child_maps.reserve(budget + 1);
+    parents[0] = -1;
+    depths[0] = 0;
+    int64_t count = 0;
+    while (!heap.empty() && count < budget) {
+        MixEntry e = heap.top();
+        heap.pop();
+        const int64_t token = ids[at(e.mode, e.depth - 1, e.rank)];
+        int64_t current;
+        auto found = child_maps[e.parent].find(token);
+        if (found == child_maps[e.parent].end()) {
+            current = count + 1;
+            tokens[current] = token;
+            depths[current] = e.depth;
+            parents[current] = e.parent;
+            child_maps.emplace_back();
+            child_maps[e.parent][token] = current;
+            ++count;
+        } else {
+            current = found->second;
+        }
+        if (e.rank + 1 < topk) {
+            const double lw = e.logw - static_cast<double>(lp[at(e.mode, e.depth - 1, e.rank)])
+                              + static_cast<double>(lp[at(e.mode, e.depth - 1, e.rank + 1)]);
+            heap.push(MixEntry{key(lw, e.mode), e.mode, e.parent, e.depth, e.rank + 1, lw});
+        }
+        if (e.depth < depth_limit) {
+            const double lw = e.logw + static_cast<double>(lp[at(e.mode, e.depth, 0)]);
+            heap.push(MixEntry{key(lw, e.mode), e.mode, static_cast<int>(current), e.depth + 1, 0, lw});
+        }
+    }
+    return count;
+}
+
+}  // namespace
+
+// top_log_probs: [bs, K, L, k] float32; top_ids: [bs, K, L, k] int32; log_prior: [bs, K] float32 (CPU, contiguous).
+// Outputs (CPU int64, contiguous): tree [bs, 3, B + 1] = tokens, depths, parents (index 0 = root), counts [bs].
+// Unused tail entries (index > count) are set to tokens 0 / depths 0 / parents -1.
+void build_trees(torch::Tensor top_log_probs, torch::Tensor top_ids, torch::Tensor log_prior, int64_t bs,
+                 int64_t budget, torch::Tensor tree, torch::Tensor counts) {
+    const int64_t num_modes = top_log_probs.size(1), depth_limit = top_log_probs.size(2), topk = top_log_probs.size(3);
+    const int64_t width = budget + 1;
+    TORCH_CHECK(tree.is_contiguous() && tree.size(1) == 3 && tree.size(2) == width);
+    TORCH_CHECK(top_log_probs.is_contiguous() && top_ids.is_contiguous() && log_prior.is_contiguous());
+    const float* lp = top_log_probs.data_ptr<float>();
+    const int32_t* ids = top_ids.data_ptr<int32_t>();
+    const float* prior = log_prior.data_ptr<float>();
+    int64_t* out = tree.data_ptr<int64_t>();
+    int64_t* cnt = counts.data_ptr<int64_t>();
+    const int64_t per_req = num_modes * depth_limit * topk;
+    for (int64_t b = 0; b < bs; ++b) {
+        int64_t* t = out + b * 3 * width;
+        int64_t* d = t + width;
+        int64_t* p = d + width;
+        int64_t n;
+        if (num_modes == 1) {
+            n = build_single_one(lp + b * per_req, ids + b * per_req, depth_limit, topk, budget, t, d, p);
+        } else {
+            n = build_mixture_one(lp + b * per_req, ids + b * per_req, prior + b * num_modes, num_modes,
+                                  depth_limit, topk, budget, t, d, p);
+        }
+        t[0] = 0;
+        for (int64_t i = n + 1; i < width; ++i) { t[i] = 0; d[i] = 0; p[i] = -1; }
+        cnt[b] = n;
+    }
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("build_trees", &build_trees);
+}
+"""
+
+_MODULE = None
+
+
+def load_tree_module():
+    global _MODULE
+    if _MODULE is None:
+        from torch.utils.cpp_extension import load_inline
+
+        _MODULE = load_inline(
+            name="sglang_ddtree_build_v1",
+            cpp_sources=[_CPP_SOURCE],
+            extra_cflags=["-O3"],
+            verbose=False,
+        )
+    return _MODULE
+
+
+def build_trees_cpu(
+    *,
+    top_log_probs: torch.Tensor,
+    top_ids: torch.Tensor,
+    log_prior: torch.Tensor,
+    bs: int,
+    budget: int,
+    tree: torch.Tensor,
+    counts: torch.Tensor,
+) -> None:
+    """Host tree build for ``bs`` requests into ``tree[bs, 3, B + 1]`` (tokens,
+    depths, parents; see the C++ ``build_trees``)."""
+    load_tree_module().build_trees(
+        top_log_probs, top_ids, log_prior, bs, budget, tree, counts
+    )
+
+
+# --------------------------------------------------------------------------- draft top-k
+
+
+@triton.jit
+def _row_logsumexp_kernel(x_ptr, out_ptr, V, stride, BLOCK: tl.constexpr):
+    # One pass over a bf16 row with float32 accumulation (online max and sum), as
+    # tree_logits.row_logsumexp of the reference.
+    row = tl.program_id(0)
+    base = x_ptr + row.to(tl.int64) * stride
+    m = tl.full([BLOCK], float("-inf"), tl.float32)
+    s = tl.zeros([BLOCK], tl.float32)
+    for start in range(0, V, BLOCK):
+        offs = start + tl.arange(0, BLOCK)
+        x = tl.load(base + offs, mask=offs < V, other=float("-inf")).to(tl.float32)
+        m_new = tl.maximum(m, x)
+        s = tl.where(
+            m_new == float("-inf"), 0.0, s * tl.exp(m - m_new) + tl.exp(x - m_new)
+        )
+        m = m_new
+    row_max = tl.max(m, axis=0)
+    total = tl.sum(s * tl.exp(m - row_max), axis=0)
+    tl.store(out_ptr + row, row_max + tl.log(total))
+
+
+def row_logsumexp(x: torch.Tensor, out: Optional[torch.Tensor] = None) -> torch.Tensor:
+    """log-sum-exp over the last dim of a 2D row-major CUDA tensor, float32 [rows]."""
+    assert x.ndim == 2 and x.stride(1) == 1
+    rows = x.shape[0]
+    if out is None:
+        out = torch.empty(rows, device=x.device, dtype=torch.float32)
+    if rows > 0:
+        _row_logsumexp_kernel[(rows,)](
+            x, out, x.shape[1], x.stride(0), BLOCK=4096, num_warps=8
+        )
+    return out
+
+
+class DDTreeDraftTopK:
+    """Top-k candidates of every drafted position, folded into the draft cuda graph.
+
+    Called on the draft hidden states ``[bs * num_modes * block_size, H]`` (each
+    block: the anchor then the ``block_size - 1`` drafted positions). Writes
+    ``top_logp[bs, K, L, k]`` (float32 log-probabilities: bf16 top-k minus an fp32
+    log Z) and ``top_ids[bs, K, L, k]`` (int32 token ids) into static buffers.
+    ``k = min(budget, vocab)`` reaches every rank a best-first tree of ``budget``
+    nodes can use. TP=1 only (the full vocab is local).
+
+    Reduced draft vocabulary (``vocab_ids``, SGLANG_DFLASH_DDTREE_DRAFT_VOCAB): ``weight``
+    is then the LM head's rows of those ids ``[N, H]``; logits, top-k and log Z run over
+    the N subset tokens (the candidates' log-probs are renormalized over the subset) and
+    the top-k indices map back to full-vocabulary ids through ``vocab_ids`` (int32 [N]).
+    """
+
+    def __init__(
+        self,
+        *,
+        weight: torch.Tensor,
+        block_size: int,
+        num_modes: int,
+        budget: int,
+        max_bs: int,
+        vocab_ids: Optional[torch.Tensor] = None,
+    ):
+        self.weight = weight
+        self.block_size = int(block_size)
+        self.num_modes = int(num_modes)
+        self.vocab = int(weight.shape[0])
+        if vocab_ids is not None:
+            assert vocab_ids.dtype == torch.int32 and vocab_ids.shape == (self.vocab,), (
+                vocab_ids.dtype,
+                vocab_ids.shape,
+                weight.shape,
+            )
+        self.vocab_ids = vocab_ids
+        self.topk = int(min(budget, self.vocab))
+        self.max_bs = int(max_bs)
+        device = weight.device
+        rows = self.max_bs * self.num_modes * (self.block_size - 1)
+        self.top_logp = torch.empty((rows, self.topk), dtype=torch.float32, device=device)
+        self.top_ids = torch.empty((rows, self.topk), dtype=torch.int32, device=device)
+        self.log_z = torch.empty((rows,), dtype=torch.float32, device=device)
+
+    def __call__(self, hidden_states: torch.Tensor, input_ids=None) -> None:
+        del input_ids
+        L = self.block_size
+        groups = hidden_states.shape[0] // L  # bs * num_modes
+        hs = hidden_states.view(groups, L, -1)[:, 1:, :].reshape(-1, hidden_states.shape[-1])
+        if hs.dtype != self.weight.dtype:
+            hs = hs.to(self.weight.dtype)
+        n = hs.shape[0]
+        logits = torch.matmul(hs, self.weight.T)  # bf16 [n, V] (V = N subset tokens with a draft vocab)
+        top_vals, top_idx = torch.topk(logits, k=self.topk, dim=-1)
+        log_z = row_logsumexp(logits, out=self.log_z[:n])
+        torch.sub(top_vals.float(), log_z.unsqueeze(1), out=self.top_logp[:n])
+        if self.vocab_ids is None:
+            self.top_ids[:n].copy_(top_idx)
+        else:  # subset positions -> full-vocabulary token ids
+            torch.index_select(self.vocab_ids, 0, top_idx.view(-1), out=self.top_ids[:n].view(-1))
+
+    def outputs(self, bs: int):
+        rows = bs * self.num_modes * (self.block_size - 1)
+        shape = (bs, self.num_modes, self.block_size - 1, self.topk)
+        return self.top_logp[:rows].view(shape), self.top_ids[:rows].view(shape)
+
+
+# --------------------------------------------------------------------------- GPU kernels
+
+
+@triton.jit
+def _ddtree_prepare_kernel(
+    bonus_ptr,
+    prefix_ptr,
+    req_pool_ptr,
+    req_to_token_ptr,
+    block_ids_ptr,
+    block_pos_ptr,
+    window_ptr,
+    r2t_stride,
+    W,
+    mask_token_id,
+    L: tl.constexpr,
+    BLOCK_L: tl.constexpr,
+    BLOCK_W: tl.constexpr,
+):
+    """Draft block ids/positions ``[bs, L]`` and the verify window's cache locs ``[bs, W]``."""
+    b = tl.program_id(0)
+    prefix = tl.load(prefix_ptr + b).to(tl.int64)
+    bonus = tl.load(bonus_ptr + b).to(tl.int64)
+    offs_l = tl.arange(0, BLOCK_L)
+    ml = offs_l < L
+    ids = tl.where(offs_l == 0, bonus, mask_token_id)
+    tl.store(block_ids_ptr + b * L + offs_l, ids, mask=ml)
+    tl.store(block_pos_ptr + b * L + offs_l, prefix + offs_l, mask=ml)
+    rp = tl.load(req_pool_ptr + b).to(tl.int64)
+    row = req_to_token_ptr + rp * r2t_stride + prefix
+    for start in range(0, W, BLOCK_W):
+        offs = start + tl.arange(0, BLOCK_W)
+        mw = offs < W
+        loc = tl.load(row + offs, mask=mw, other=0)
+        tl.store(window_ptr + b * W + offs, loc.to(tl.int64), mask=mw)
+
+
+def ddtree_prepare(
+    *,
+    bonus_tokens: torch.Tensor,
+    prefix_lens: torch.Tensor,
+    req_pool_indices: torch.Tensor,
+    req_to_token: torch.Tensor,
+    block_ids_out: torch.Tensor,
+    positions_out: torch.Tensor,
+    window_out: torch.Tensor,
+    mask_token_id: int,
+) -> None:
+    bs = int(bonus_tokens.numel())
+    if bs == 0:
+        return
+    L = int(block_ids_out.shape[1])
+    W = int(window_out.shape[1])
+    assert req_to_token.stride(1) == 1
+    _ddtree_prepare_kernel[(bs,)](
+        bonus_tokens,
+        prefix_lens,
+        req_pool_indices,
+        req_to_token,
+        block_ids_out,
+        positions_out,
+        window_out,
+        req_to_token.stride(0),
+        W,
+        int(mask_token_id),
+        L=L,
+        BLOCK_L=triton.next_power_of_2(L),
+        BLOCK_W=min(1024, triton.next_power_of_2(W)),
+        num_warps=4,
+    )
+
+
+@triton.jit
+def _ddtree_verify_inputs_kernel(
+    root_ptr,
+    prefix_ptr,
+    tok_ptr,
+    depth_ptr,
+    parent_ptr,
+    mask_off_ptr,
+    ids_out_ptr,
+    pos_out_ptr,
+    mask_ptr,
+    W,
+    tree_stride,
+    MAX_DEPTH: tl.constexpr,
+    BLOCK_W: tl.constexpr,
+    BLOCK_P: tl.constexpr,
+):
+    """Program (b, i): row i of request b's flat tree mask ``[W, prefix + W]`` (the
+    prefix fully visible, then node i's ancestors including itself) and node i's
+    verify token / position."""
+    b = tl.program_id(0)
+    i = tl.program_id(1)
+    prefix = tl.load(prefix_ptr + b).to(tl.int64)
+    base = tl.load(mask_off_ptr + b).to(tl.int64)
+    row_len = prefix + W
+    row_ptr = mask_ptr + base + i.to(tl.int64) * row_len
+    ones = tl.full([BLOCK_P], 1, tl.int8)
+    for start in range(0, prefix, BLOCK_P):
+        offs = start + tl.arange(0, BLOCK_P)
+        tl.store(row_ptr + offs, ones, mask=offs < prefix)
+    cols = tl.arange(0, BLOCK_W)
+    vis = tl.zeros([BLOCK_W], tl.int8)
+    anc = i.to(tl.int64)
+    for _ in range(MAX_DEPTH + 1):
+        vis = tl.where((cols == anc) & (anc >= 0), 1, vis).to(tl.int8)
+        nxt = tl.load(parent_ptr + b * tree_stride + tl.maximum(anc, 0))
+        anc = tl.where(anc > 0, nxt, -1).to(tl.int64)
+    tl.store(row_ptr + prefix + cols, vis, mask=cols < W)
+    tok = tl.load(tok_ptr + b * tree_stride + i)
+    root = tl.load(root_ptr + b).to(tl.int64)
+    depth = tl.load(depth_ptr + b * tree_stride + i)
+    tl.store(ids_out_ptr + b * W + i, tl.where(i == 0, root, tok))
+    tl.store(pos_out_ptr + b * W + i, prefix + depth)
+
+
+def ddtree_verify_inputs(
+    *,
+    root_tokens: torch.Tensor,
+    prefix_lens: torch.Tensor,
+    tokens: torch.Tensor,
+    depths: torch.Tensor,
+    parents: torch.Tensor,
+    mask_offsets: torch.Tensor,
+    ids_out: torch.Tensor,
+    positions_out: torch.Tensor,
+    mask_out: torch.Tensor,
+    max_depth: int,
+) -> None:
+    bs, W = tokens.shape
+    if bs == 0:
+        return
+    assert tokens.stride() == depths.stride() == parents.stride() and tokens.stride(1) == 1
+    _ddtree_verify_inputs_kernel[(bs, W)](
+        root_tokens,
+        prefix_lens,
+        tokens,
+        depths,
+        parents,
+        mask_offsets,
+        ids_out,
+        positions_out,
+        mask_out.view(torch.int8),
+        W,
+        tokens.stride(0),
+        MAX_DEPTH=int(max_depth),
+        BLOCK_W=triton.next_power_of_2(W),
+        BLOCK_P=1024,
+        num_warps=4,
+    )
+
+
+@triton.jit
+def _ddtree_follow_kernel(
+    post_ptr,
+    tok_ptr,
+    parent_ptr,
+    window_ptr,
+    prefix_ptr,
+    accept_len_ptr,
+    commit_ptr,
+    bonus_ptr,
+    out_tokens_ptr,
+    new_seq_ptr,
+    mv_src_ptr,
+    mv_tgt_ptr,
+    hid_idx_ptr,
+    W,
+    parent_stride,
+    L: tl.constexpr,
+    BLOCK_W: tl.constexpr,
+    BLOCK_L: tl.constexpr,
+):
+    """Walk request b's tree along the target's token at each node (ddtree
+    follow_verified_tree) and emit the commit: the accepted path, its tokens + bonus,
+    the KV moves that compact the path to the front of the window, and the hidden
+    rows of the path."""
+    b = tl.program_id(0)
+    cols = tl.arange(0, BLOCK_W)
+    mw = cols < W
+    par = tl.load(parent_ptr + b * parent_stride + cols, mask=mw, other=-2)
+    tok = tl.load(tok_ptr + b * W + cols, mask=mw, other=-1)
+    lanes = tl.arange(0, BLOCK_L)
+    path = tl.zeros([BLOCK_L], tl.int64)
+    emitted = tl.zeros([BLOCK_L], tl.int64)
+    cur = tl.zeros([], tl.int64)
+    n = tl.zeros([], tl.int64)
+    alive = tl.full([], 1, tl.int64)
+    for _ in range(L - 1):
+        t = tl.load(post_ptr + b * W + cur)
+        match = (par == cur) & (tok == t) & mw
+        child = tl.max(tl.where(match, cols, -1), axis=0).to(tl.int64)
+        hit = (child >= 0) & (alive > 0)
+        emitted = tl.where(hit & (lanes == n), t, emitted)
+        n = tl.where(hit, n + 1, n)
+        path = tl.where(hit & (lanes == n), child, path)
+        cur = tl.where(hit, child, cur)
+        alive = tl.where(hit, alive, 0)
+    bonus = tl.load(post_ptr + b * W + cur)
+    emitted = tl.where(lanes == n, bonus, emitted)
+    prefix = tl.load(prefix_ptr + b).to(tl.int64)
+    ml = lanes < L
+    live = lanes <= n
+    tl.store(out_tokens_ptr + b * L + lanes, emitted, mask=ml)
+    tl.store(hid_idx_ptr + b * L + lanes, b * W + path, mask=ml)
+    src = tl.load(window_ptr + b * W + path, mask=ml & live, other=0)
+    tgt = tl.load(window_ptr + b * W + lanes, mask=ml & live, other=0)
+    tl.store(mv_src_ptr + b * L + lanes, src, mask=ml)
+    tl.store(mv_tgt_ptr + b * L + lanes, tgt, mask=ml)
+    tl.store(accept_len_ptr + b, n.to(tl.int32))
+    tl.store(commit_ptr + b, (n + 1).to(tl.int32))
+    tl.store(bonus_ptr + b, bonus.to(tl.int64))
+    tl.store(new_seq_ptr + b, prefix + n + 1)
+
+
+@triton.jit
+def _ddtree_compact_kv_kernel(
+    data_ptrs,
+    src_ptr,
+    tgt_ptr,
+    SLOT_WORDS: tl.constexpr,
+    TILE_WORDS: tl.constexpr,
+    L: tl.constexpr,
+    BLOCK_L: tl.constexpr,
+):
+    """Request b's commit moves in one KV buffer and one tile of the slot. Every source is loaded
+    before any store (a path slot can be another move's target); no-op moves (source == target, the
+    lanes past the path included) are masked out."""
+    b = tl.program_id(0)
+    buf = tl.program_id(1)
+    tile = tl.program_id(2)
+    lanes = tl.arange(0, BLOCK_L)
+    ml = lanes < L
+    src = tl.load(src_ptr + b * L + lanes, mask=ml, other=0)
+    tgt = tl.load(tgt_ptr + b * L + lanes, mask=ml, other=0)
+    move = ml & (src != tgt)
+    if tl.max(move.to(tl.int32), axis=0) == 0:
+        return
+    base = tl.cast(tl.load(data_ptrs + buf), tl.pointer_type(tl.int64))
+    words = tile * TILE_WORDS + tl.arange(0, TILE_WORDS)
+    mask = move[:, None] & (words[None, :] < SLOT_WORDS)
+    vals = tl.load(base + src[:, None] * SLOT_WORDS + words[None, :], mask=mask)
+    tl.store(base + tgt[:, None] * SLOT_WORDS + words[None, :], vals, mask=mask)
+
+
+class DDTreeKVCompactor:
+    """Commit-time KV moves of DDTree rounds on a plain token-major MHA pool: only the moves that
+    change a slot, one program per (request, buffer, tile). The pool's generic move copies every
+    entry of the [bs, L] move list (including the no-ops) through byte tiles."""
+
+    TILE_BYTES = 1024
+
+    def __init__(self, kv_pool):
+        strides = {int(s) for s in kv_pool.data_strides.tolist()}
+        if len(strides) != 1 or next(iter(strides)) % 8:
+            raise ValueError(f"DDTree KV compaction needs one slot stride (multiple of 8 bytes), got {strides}")
+        self.data_ptrs = kv_pool.data_ptrs
+        self.slot_words = next(iter(strides)) // 8
+        self.tile_words = min(self.slot_words, self.TILE_BYTES // 8)
+
+    @staticmethod
+    def supports(kv_pool) -> bool:
+        from sglang.srt.mem_cache.memory_pool import MHATokenToKVPool
+
+        return (
+            type(kv_pool) is MHATokenToKVPool
+            and not kv_pool.use_hnd
+            and not kv_pool.use_native_move_kv_cache
+            and kv_pool.native_k_scale_buffer is None
+            and kv_pool.k_scale_buffer is None
+            and kv_pool.layer_num > 0
+        )
+
+    def __call__(self, *, move_src: torch.Tensor, move_tgt: torch.Tensor) -> None:
+        bs, L = move_src.shape
+        if bs == 0:
+            return
+        grid = (bs, self.data_ptrs.numel(), triton.cdiv(self.slot_words, self.tile_words))
+        _ddtree_compact_kv_kernel[grid](
+            self.data_ptrs,
+            move_src,
+            move_tgt,
+            SLOT_WORDS=self.slot_words,
+            TILE_WORDS=self.tile_words,
+            L=L,
+            BLOCK_L=triton.next_power_of_2(L),
+            num_warps=4,
+        )
+
+
+def ddtree_follow(
+    *,
+    posterior: torch.Tensor,
+    verify_ids: torch.Tensor,
+    parents: torch.Tensor,
+    window: torch.Tensor,
+    prefix_lens: torch.Tensor,
+    accept_len_out: torch.Tensor,
+    commit_lens_out: torch.Tensor,
+    bonus_out: torch.Tensor,
+    out_tokens_out: torch.Tensor,
+    new_seq_lens_out: torch.Tensor,
+    move_src_out: torch.Tensor,
+    move_tgt_out: torch.Tensor,
+    hidden_index_out: torch.Tensor,
+) -> None:
+    bs, W = verify_ids.shape
+    if bs == 0:
+        return
+    L = int(out_tokens_out.shape[1])
+    assert parents.stride(1) == 1 and posterior.is_contiguous() and window.is_contiguous()
+    _ddtree_follow_kernel[(bs,)](
+        posterior,
+        verify_ids,
+        parents,
+        window,
+        prefix_lens,
+        accept_len_out,
+        commit_lens_out,
+        bonus_out,
+        out_tokens_out,
+        new_seq_lens_out,
+        move_src_out,
+        move_tgt_out,
+        hidden_index_out,
+        W,
+        parents.stride(0),
+        L=L,
+        BLOCK_W=triton.next_power_of_2(W),
+        BLOCK_L=triton.next_power_of_2(L),
+        num_warps=4,
+    )
+
+
+@triton.jit
+def _ddtree_mode_mask_kernel(
+    prefix_ptr,
+    mask_off_ptr,
+    mask_ptr,
+    KL,
+    L: tl.constexpr,
+    BLOCK_KL: tl.constexpr,
+    BLOCK_P: tl.constexpr,
+):
+    """Program (b, r): row r of request b's multi-mode draft mask ``[K * L, prefix + K * L]``:
+    the whole context, then the L keys of row r's own mode block (block-diagonal)."""
+    b = tl.program_id(0)
+    r = tl.program_id(1)
+    prefix = tl.load(prefix_ptr + b).to(tl.int64)
+    base = tl.load(mask_off_ptr + b).to(tl.int64)
+    row_ptr = mask_ptr + base + r.to(tl.int64) * (prefix + KL)
+    ones = tl.full([BLOCK_P], 1, tl.int8)
+    for start in range(0, prefix, BLOCK_P):
+        offs = start + tl.arange(0, BLOCK_P)
+        tl.store(row_ptr + offs, ones, mask=offs < prefix)
+    cols = tl.arange(0, BLOCK_KL)
+    vis = ((cols // L) == (r // L)).to(tl.int8)
+    tl.store(row_ptr + prefix + cols, vis, mask=cols < KL)
+
+
+def ddtree_mode_mask(
+    *,
+    prefix_lens: torch.Tensor,
+    mask_offsets: torch.Tensor,
+    mask_out: torch.Tensor,
+    num_modes: int,
+    block_size: int,
+) -> None:
+    bs = int(prefix_lens.numel())
+    KL = int(num_modes) * int(block_size)
+    if bs == 0:
+        return
+    _ddtree_mode_mask_kernel[(bs, KL)](
+        prefix_lens,
+        mask_offsets,
+        mask_out.view(torch.int8),
+        KL,
+        L=int(block_size),
+        BLOCK_KL=triton.next_power_of_2(KL),
+        BLOCK_P=1024,
+        num_warps=4,
+    )
+
+
+def ancestor_visibility_reference(parents: torch.Tensor) -> torch.Tensor:
+    """[W, W] bool ancestor-or-self matrix of one tree (tests only)."""
+    W = parents.numel()
+    vis = torch.zeros((W, W), dtype=torch.bool)
+    p = parents.tolist()
+    for i in range(W):
+        j = i
+        while j >= 0:
+            vis[i, j] = True
+            j = p[j] if j > 0 else -1
+    return vis
