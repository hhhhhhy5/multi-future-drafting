+
+class _StageTimer:
+    """Per-round stage times (SGLANG_DFLASH_DDTREE_TIMING=N logs every N rounds).
+
+    CUDA events mark the stage boundaries on the forward stream; finished rounds are
+    folded in without waiting (``Event.query``)."""
+
+    GPU_STAGES = ("between_rounds", "draft", "tree_gap", "verify", "commit")
+    # Optional split of the draft stage (marks draft_fwd / draft_layers): before the drafter forward, the
+    # drafter forward (with the top-k head when it is folded into the draft graph), the eager top-k head.
+    DRAFT_SPLIT = ("draft_pre", "draft_layers", "draft_head")
+    CPU_STAGES = (
+        "cpu_wait_draft",
+        "cpu_tree_build",
+        "cpu_verify_launch",
+        "cpu_round",
+        "cpu_to_draft",
+        "cpu_to_verify_start",
+        "cpu_to_verify_end",
+        "cpu_to_end",
+    )
+
+    def __init__(self, every: int):
+        self.every = every
+        self.rounds = 0
+        self.sums = {k: 0.0 for k in self.GPU_STAGES + self.CPU_STAGES}
+        self.by_bs = {}  # bs -> {"rounds": n, stage: ms sum} over the GPU stages and the draft split
+        self.pending = []
+        self.prev_end = None
+        self.current = None
+        self.round_start = None
+
+    def mark(self, name: str) -> None:
+        now = time.perf_counter()
+        if self.current is None:
+            self.current = {}
+            self.round_start = now
+        elif f"cpu_to_{name}" in self.sums:
+            self.sums[f"cpu_to_{name}"] += (now - self.last_mark) * 1e3
+        self.last_mark = now
+        event = torch.cuda.Event(enable_timing=True)
+        event.record()
+        self.current[name] = event
+
+    def set_bs(self, bs: int) -> None:
+        self.current["bs"] = bs
+
+    def cpu(self, name: str, seconds: float) -> None:
+        self.sums[name] += seconds * 1e3
+
+    def end_round(self) -> None:
+        self.mark("end")
+        self.cpu("cpu_round", time.perf_counter() - self.round_start)
+        self.pending.append(self.current)
+        self.current = None
+        while self.pending and self.pending[0]["end"].query():
+            self._fold(self.pending.pop(0))
+
+    def collect(self) -> None:
+        pass
+
+    def _fold(self, ev) -> None:
+        if self.prev_end is not None:
+            self.sums["between_rounds"] += self.prev_end.elapsed_time(ev["start"])
+        stages = {
+            "draft": ev["start"].elapsed_time(ev["draft"]),
+            "tree_gap": ev["draft"].elapsed_time(ev["verify_start"]),
+            "verify": ev["verify_start"].elapsed_time(ev["verify_end"]),
+            "commit": ev["verify_end"].elapsed_time(ev["end"]),
+        }
+        if "draft_fwd" in ev and "draft_layers" in ev:
+            stages["draft_pre"] = ev["start"].elapsed_time(ev["draft_fwd"])
+            stages["draft_layers"] = ev["draft_fwd"].elapsed_time(ev["draft_layers"])
+            stages["draft_head"] = ev["draft_layers"].elapsed_time(ev["draft"])
+        for k in ("draft", "tree_gap", "verify", "commit"):
+            self.sums[k] += stages[k]
+        per_bs = self.by_bs.setdefault(ev.get("bs", 0), {"rounds": 0})
+        per_bs["rounds"] += 1
+        for k, v in stages.items():
+            per_bs[k] = per_bs.get(k, 0.0) + v
+        self.prev_end = ev["end"]
+        self.rounds += 1
+        if self.rounds % self.every == 0:
+            avg = ", ".join(f"{k} {v / self.rounds:.3f}" for k, v in self.sums.items())
+            logger.warning("DDTree stage ms/round over %d rounds: %s", self.rounds, avg)
+            # The full batch: the largest batch size seen in at least 20 rounds.
+            full = [kv for kv in self.by_bs.items() if kv[1]["rounds"] >= 20] or list(self.by_bs.items())
+            bs, s = max(full, key=lambda kv: kv[0])
+            split = ", ".join(f"{k} {v / s['rounds']:.3f}" for k, v in s.items() if k != "rounds")
+            logger.warning("DDTree stage ms/round at bs=%d over %d rounds: %s", bs, s["rounds"], split)
+
+
+class _HostBuffers(msgspec.Struct, kw_only=True):
+    """Pinned host staging of one round (capacity ``cap`` requests)."""
+
+    cap: int
+    top_logp: torch.Tensor  # [cap, K, L - 1, k] float32
+    top_ids: torch.Tensor  # [cap, K, L - 1, k] int32
+    log_prior: torch.Tensor  # [cap, K] float32 (uniform prior: zeros)
+    prefix_lens: torch.Tensor  # [cap] int64
+    tree: torch.Tensor  # [cap, 3, W] int64: tokens, depths, parents (index 0 = root)
+    counts: torch.Tensor  # [cap] int64
+    mask_offsets: torch.Tensor  # [cap] int64, verify mask
+    ready: torch.cuda.Event
+
+
+class _Profile(msgspec.Struct, kw_only=True):
+    """A tree configuration and its round state; the switch's other profiles also own decode graphs."""
+
+    spec: DDTreeProfile
+    budget: int
+    num_modes: int
+    mode_subset: tuple
+    verify_width: int  # root + B nodes
+    draft_width: int  # one block per mode
+    window_width: int  # KV slots per request per round
+    max_bs: int
+    topk_head: DDTreeDraftTopK
+    draft_block_spec_info: DFlashVerifyInput
+    mode_attn_impl: Optional[str]
+    mode_attention: Optional[PagedModeAttention] = None
+    mode_embed: Optional[torch.Tensor] = None  # resolved on the first round (weights load after __init__)
+    host: Optional[_HostBuffers] = None
+    target_graph: Optional[object] = None  # decode graph runners; None: the model runners' own
+    draft_graph: Optional[object] = None
+
+
+def _has_decode_graphs(model_runner) -> bool:
+    runner = model_runner.decode_cuda_graph_runner
+    return runner is not None and runner is not model_runner.eager_runner
+
+
+def _capture_decode_graphs(model_runner, *, width: int):
+    """Another decode graph runner on ``model_runner`` for the profile being captured, on an attention
+    backend of its own (as the adaptive EAGLE worker's per-step target graphs)."""
+    tic = time.perf_counter()
+    free_before = torch.cuda.mem_get_info()[0]
+    backend = model_runner._get_attention_backend()
+    backend.prefill_attention_backend_str = model_runner.prefill_attention_backend_str
+    backend.decode_attention_backend_str = model_runner.decode_attention_backend_str
+    model_runner.kv_index_translator.bind_and_verify_backends([backend])
+    runner = model_runner._decode_cuda_graph_runner_cls()(
+        model_runner, attn_backend=backend, speculative_num_draft_tokens=width
+    )
+    logger.info(
+        "DDTree switch profile: %s decode graphs bs=%s width=%d, %.1f s, %.2f GB",
+        "draft" if model_runner.is_draft_worker else "target",
+        runner.capture_bs,
+        runner.captured_req_width,
+        time.perf_counter() - tic,
+        (free_before - torch.cuda.mem_get_info()[0]) / 2**30,
+    )
+    return runner
+
+
+class DDTreeWorkerV2(DFlashWorkerV2):
+    def __init__(
+        self,
+        server_args: ServerArgs,
+        gpu_id: int,
+        nccl_port: int,
+        target_worker: TpModelWorker,
+    ):
+        super().__init__(
+            server_args=server_args,
+            gpu_id=gpu_id,
+            nccl_port=nccl_port,
+            target_worker=target_worker,
+        )
+        specs = ddtree_profiles()
+        primary = specs[0]
+        verify_width = int(get_spec().speculative_num_draft_tokens)
+        if verify_width != primary.budget + 1:
+            raise ValueError(
+                "DDTree needs speculative_num_draft_tokens == budget + 1, got "
+                f"{verify_width} for budget {primary.budget}."
+            )
+        if int(get_parallel().tp_size) != 1 or get_parallel().attn_dp_enabled:
+            raise ValueError("DDTree supports tp_size == 1 without dp attention only.")
+        if self.selector is not None or self.lilicorr is not None or self._is_domino:
+            raise ValueError("DDTree supports plain DFlash block drafts only.")
+        if self.use_compact_draft_cache:
+            raise ValueError("DDTree does not support --speculative-draft-window-size.")
+        draft_config = parse_dflash_draft_config(
+            draft_hf_config=self.draft_model_runner.model_config.hf_config
+        )
+        block_size = int(draft_config.resolve_block_size(default=16))
+        if block_size != ddtree_block_size():
+            raise ValueError(
+                f"Draft block_size={block_size} but SGLANG_DFLASH_DDTREE_BLOCK_SIZE="
+                f"{ddtree_block_size()}; they must match."
+            )
+        # The chain worker sized its draft block from speculative_num_draft_tokens,
+        # which is the tree's verify width here.
+        self.block_size = block_size
+        self.draft_model.set_block_size(block_size)
+        self._block_pos_offsets = build_block_pos_offsets(
+            length=block_size, device=self.device
+        )
+        self._draft_block_ids_buf = None
+        # Index draft_modes is the default path (no mode vector) with SGLANG_DFLASH_DDTREE_DEFAULT_MODE.
+        self._num_branches = self.draft_model.num_modes + int(
+            bool(envs.SGLANG_DFLASH_DDTREE_DEFAULT_MODE.get())
+        )
+        self._lm_head_weight = unwrap_lora_layer(
+            self.target_worker.model_runner.model.lm_head
+        ).weight
+        # Reduced draft vocabulary: the draft head owns a copy of those LM-head rows ([N, H]), refreshed in place on
+        # the first decode round (the target's weights may finish loading after this worker is built).
+        self._draft_vocab = None  # int64 [N] subset ids on the device (None: the full vocabulary)
+        self._draft_vocab_ids = None  # the same ids as int32 (the head's top-k id map)
+        self._draft_head_weight = self._lm_head_weight
+        self._draft_head_synced = True
+        vocab_path = ddtree_draft_vocab_path()
+        if vocab_path:
+            self._draft_vocab = load_draft_vocab(
+                vocab_path, vocab_size=int(self._lm_head_weight.shape[0])
+            ).to(self._lm_head_weight.device)
+            self._draft_vocab_ids = self._draft_vocab.to(torch.int32)
+            self._draft_head_weight = self._lm_head_weight.index_select(0, self._draft_vocab).contiguous()
+            self._draft_head_synced = False
+        max_bs = self._max_bs()
+        if specs[-1].min_bs > max_bs:
+            logger.warning(
+                "DDTree switch: no batch reaches the profiles from %d requests on (max %d).",
+                min(p.min_bs for p in specs if p.min_bs > max_bs),
+                max_bs,
+            )
+            specs = [p for p in specs if p.min_bs <= max_bs]
+        # Mode attention objects are made in init_cuda_graphs: the draft KV pool does not exist yet.
+        self._profiles = [
+            self._make_profile(spec, max_bs=specs[i + 1].min_bs - 1 if i + 1 < len(specs) else max_bs)
+            for i, spec in enumerate(specs)
+        ]
+        # The profile whose draft graphs are being captured: the graphs fold in its top-k head.
+        self._capturing = self._profiles[0]
+        self._mode_attn_check = self._profiles[0].num_modes > 1 and bool(
+            envs.SGLANG_DFLASH_DDTREE_MODE_ATTN_CHECK.get()
+        )
+        self._mode_attn_check_stats = None
+        self._trace_path = envs.SGLANG_DFLASH_DDTREE_TRACE.get()
+        self._async = ddtree_async_enabled()
+        self._build_thread = (
+            TreeBuildThread(torch.device(self.device)) if ddtree_async_mode() == 2 else None
+        )
+        self._check_host_lens = bool(envs.SGLANG_DFLASH_DDTREE_CHECK_HOST_LENS.get())
+        # The commit's KV move: made on the first commit (the KV pool is attached after __init__).
+        self._kv_move = None
+        timing_every = int(envs.SGLANG_DFLASH_DDTREE_TIMING.get())
+        self._timer = _StageTimer(timing_every) if timing_every > 0 else None
+        load_tree_module()
+        if self._async:
+            load_async_module()
+        if get_parallel().tp_rank == 0:
+            for p in self._profiles:
+                logger.info(
+                    "DDTree enabled (batches %d-%d): budget=%d verify_width=%d draft block_size=%d "
+                    "num_modes=%d subset=%s window=%d topk=%d async=%s draft_vocab=%s",
+                    p.spec.min_bs,
+                    p.max_bs,
+                    p.budget,
+                    p.verify_width,
+                    block_size,
+                    p.num_modes,
+                    p.mode_subset or "all",
+                    p.window_width,
+                    p.topk_head.topk,
+                    self._async,
+                    "full" if self._draft_vocab is None else f"{p.topk_head.vocab} ({vocab_path})",
+                )
+
+    def _make_profile(self, spec: DDTreeProfile, *, max_bs: int) -> _Profile:
+        draft_modes = self.draft_model.num_modes
+        subset = spec.mode_subset
+        if spec.budget <= 0:
+            raise ValueError(f"DDTree profile {spec}: the budget must be positive.")
+        if not subset and spec.num_modes != draft_modes:
+            raise ValueError(
+                f"DDTree profile {spec}: NUM_MODES={spec.num_modes} but the draft has "
+                f"{draft_modes} mode(s); they must match."
+            )
+        if subset and (
+            draft_modes < 2
+            or len(subset) != spec.num_modes
+            or len(set(subset)) != len(subset)
+            or not all(0 <= m < self._num_branches for m in subset)
+        ):
+            raise ValueError(
+                f"DDTree profile {spec}: the mode subset must name NUM_MODES={spec.num_modes} "
+                f"distinct branches of the {draft_modes}-mode draft "
+                f"(index {draft_modes}: its default path, with SGLANG_DFLASH_DDTREE_DEFAULT_MODE=1)."
+            )
+        impl = ddtree_mode_attention_impl() if spec.num_modes > 1 else None
+        if impl not in (None, "triton", "flashinfer", "reference"):
+            raise ValueError(f"Unknown SGLANG_DFLASH_DDTREE_MODE_ATTN={impl!r}.")
+        verify_width, draft_width = spec.budget + 1, self.block_size * spec.num_modes
+        return _Profile(
+            spec=spec,
+            budget=spec.budget,
+            num_modes=spec.num_modes,
+            mode_subset=subset,
+            verify_width=verify_width,
+            draft_width=draft_width,
+            window_width=max(verify_width, draft_width),
+            max_bs=max_bs,
+            topk_head=DDTreeDraftTopK(
+                weight=self._draft_head_weight,
+                block_size=self.block_size,
+                num_modes=spec.num_modes,
+                budget=spec.budget,
+                max_bs=max_bs,
+                vocab_ids=self._draft_vocab_ids,
+            ),
+            draft_block_spec_info=make_draft_block_spec_info(
+                draft_token_num=draft_width, device=self.device
+            ),
+            mode_attn_impl=impl,
+        )
+
+    def init_cuda_graphs(self):
+        primary = self._profiles[0]
+        # The multi-mode draft attention hook must be in place before the draft graph is captured.
+        self._ensure_mode_attention()
+        self._set_mode_attention(primary.mode_attention)
+        super().init_cuda_graphs()
+        primary.target_graph = self.target_worker.model_runner.decode_cuda_graph_runner
+        primary.draft_graph = self.draft_model_runner.decode_cuda_graph_runner
+        for p in self._profiles[1:]:
+            self._capture_profile_graphs(p)
+        self._capturing = primary
+        self._set_mode_attention(primary.mode_attention)
+
+    def _capture_profile_graphs(self, p: _Profile) -> None:
+        """A switch profile's target-verify and draft decode graphs (its batch sizes only)."""
+        target_runner, draft_runner = self.target_worker.model_runner, self.draft_model_runner
+        if not (_has_decode_graphs(target_runner) and _has_decode_graphs(draft_runner)):
+            logger.warning("DDTree switch profile %s runs eager: no decode cuda graphs.", p.spec)
+            return
+        self._capturing = p
+        self._set_mode_attention(p.mode_attention)
+        with ddtree_profile_override(p.spec):
+            p.target_graph = _capture_decode_graphs(target_runner, width=p.verify_width)
+            with draft_pp_context(), draft_tp_context(self.draft_owns_attention):
+                p.draft_graph = _capture_decode_graphs(draft_runner, width=p.verify_width)
+
+    def _select_profile(self, bs: int) -> _Profile:
+        """The batch's profile; with several, its decode graphs become the model runners' for the round."""
+        if len(self._profiles) == 1:
+            return self._profiles[0]
+        p = next(p for p in reversed(self._profiles) if p.spec.min_bs <= bs)
+        if p.draft_graph is not None:
+            self.target_worker.model_runner.decode_cuda_graph_runner = p.target_graph
+            self.draft_model_runner.decode_cuda_graph_runner = p.draft_graph
+        return p
+
+    def _ensure_mode_attention(self) -> None:
+        for p in self._profiles:
+            if p.mode_attention is None and p.mode_attn_impl in ("triton", "reference"):
+                p.mode_attention = self._new_mode_attention(
+                    impl=p.mode_attn_impl, num_modes=p.num_modes
+                )
+
+    def _set_mode_attention(self, mode_attention) -> None:
+        for layer in self.draft_model.layers:
+            layer.self_attn.mode_attention = mode_attention
+
+    def _new_mode_attention(self, *, impl: str, num_modes: int):
+        runner = self.draft_model_runner
+        if runner.kv_index_translator.reads_are_translated or self.page_size != 1:
+            raise NotImplementedError(
+                "The mode-attention kernel reads req_to_token ids as cache rows; it needs an "
+                "untranslated draft pool with page_size 1 (use SGLANG_DFLASH_DDTREE_MODE_ATTN=flashinfer)."
+            )
+        attn0 = self.draft_model.layers[0].self_attn
+        mode_attention = PagedModeAttention(
+            kv_pool=runner.token_to_kv_pool,
+            req_to_token=runner.req_to_token_pool.req_to_token,
+            num_modes=num_modes,
+            block_size=self.block_size,
+            num_heads=attn0.num_heads,
+            num_kv_heads=attn0.num_kv_heads,
+            head_dim=attn0.head_dim,
+            scaling=attn0.scaling,
+            num_ctx_splits=int(envs.SGLANG_DFLASH_DDTREE_MODE_ATTN_SPLITS.get()),
+            impl=impl,
+        )
+        for layer in self.draft_model.layers:
+            attn = layer.self_attn
+            if attn.sliding_window_size not in (None, -1) or attn.attention_sink_bias is not None:
+                raise NotImplementedError("mode attention: full attention without sinks only")
+        return mode_attention
+
+    def _max_bs(self) -> int:
+        bs = max(get_exec().graph.cuda_graph_config.decode.bs or [1])
+        max_running = get_schedule().max_running_requests
+        if max_running is not None:
+            bs = max(bs, int(max_running))
+        return int(bs)
+
+    def _maybe_build_draft_sampler(self):
+        if envs.SGLANG_DFLASH_EAGER_DRAFT_SAMPLER.get():
+            if self._target_tp_rank == 0:
+                logger.info("DDTree draft top-k head kept eager (SGLANG_DFLASH_EAGER_DRAFT_SAMPLER=1).")
+            return None
+        if self._target_tp_rank == 0:
+            logger.info("DDTree draft top-k head folded into the draft cuda graph.")
+        return self._capture_topk
+
+    def _capture_topk(self, hidden_states, input_ids=None) -> None:
+        self._capturing.topk_head(hidden_states, input_ids)
+
+    def _host_buffers(self, p: _Profile, bs: int) -> _HostBuffers:
+        if p.host is not None and p.host.cap >= bs:
+            return p.host
+        cap = max(bs, p.max_bs)
+        K, D, k, W = p.num_modes, self.block_size - 1, p.topk_head.topk, p.verify_width
+
+        def pinned(shape, dtype):
+            return torch.zeros(shape, dtype=dtype, pin_memory=True)
+
+        p.host = _HostBuffers(
+            cap=cap,
+            top_logp=pinned((cap, K, D, k), torch.float32),
+            top_ids=pinned((cap, K, D, k), torch.int32),
+            log_prior=pinned((cap, K), torch.float32),
+            prefix_lens=pinned((cap,), torch.int64),
+            tree=pinned((cap, 3, W), torch.int64),
+            counts=pinned((cap,), torch.int64),
+            mask_offsets=pinned((cap,), torch.int64),
+            ready=torch.cuda.Event(),
+        )
+        return p.host
+
+    def forward_batch_generation(
+        self,
+        batch: ScheduleBatch,
+        on_publish=None,
+        grammar_barrier=None,
+        pp_proxy_tensors=None,
+    ) -> GenerationBatchResult:
+        if (
+            batch.forward_mode.is_extend()
+            or batch.is_extend_in_batch
+            or batch.forward_mode.is_idle()
+            or batch.spec_info is None
+        ):
+            return super().forward_batch_generation(
+                batch,
+                on_publish=on_publish,
+                grammar_barrier=grammar_barrier,
+                pp_proxy_tensors=pp_proxy_tensors,
+            )
+        if batch.has_grammar:
+            raise NotImplementedError("DDTree does not support grammar constraints.")
+        return self._forward_ddtree_decode(batch, on_publish=on_publish)
+
+    # ------------------------------------------------------------------ round
+
+    def _forward_ddtree_decode(self, batch: ScheduleBatch, *, on_publish):
+        draft_input = batch.spec_info
+        if not isinstance(draft_input, DFlashDraftInputV2):
+            raise RuntimeError("DDTree expected DFlashDraftInputV2 on the running batch.")
+        self._ensure_mode_attention()
+        if not self._draft_head_synced:
+            # In place (the draft graphs hold this tensor), once, stream-ordered before the first draft.
+            self._draft_head_weight.copy_(self._lm_head_weight.index_select(0, self._draft_vocab))
+            self._draft_head_synced = True
+        device = self.device
+        batch.seq_lens.record_stream(torch.get_device_module(device).current_stream())
+        bs = len(batch.seq_lens)
+        p = self._select_profile(bs)
+        L, W, WW = int(self.block_size), p.verify_width, p.window_width
+        prefix_lens = batch.seq_lens
+        timer = self._timer
+        if timer is not None:
+            timer.mark("start")
+            timer.set_bs(int(bs))
+
+        block_ids = torch.empty((bs, L), dtype=torch.long, device=device)
+        block_positions = torch.empty((bs, L), dtype=torch.int64, device=device)
+        window = torch.empty((bs, WW), dtype=torch.int64, device=device)
+        ddtree_prepare(
+            bonus_tokens=draft_input.bonus_tokens,
+            prefix_lens=prefix_lens,
+            req_pool_indices=batch.req_pool_indices,
+            req_to_token=self.model_runner.req_to_token_pool.req_to_token,
+            block_ids_out=block_ids,
+            positions_out=block_positions,
+            window_out=window,
+            mask_token_id=int(self._mask_token_id),
+        )
+        kv_loc_plan = self.target_worker.model_runner.kv_index_translator.plan(
+            req_pool_indices=batch.req_pool_indices,
+            seq_lens=prefix_lens,
+            seq_lens_cpu=(
+                batch.seq_lens_cpu
+                if batch.seq_lens_cpu is not None
+                else draft_input.nxt_kv_lens_cpu
+            ),
+            write_virtual=window.reshape(-1),
+            read_extent=WW,
+        )
+
+        draft_out = self._run_draft_blocks(
+            p=p,
+            batch=batch,
+            draft_input=draft_input,
+            block_ids=block_ids,
+            block_positions=block_positions,
+            kv_loc_plan=kv_loc_plan,
+        )
+        if timer is not None:
+            timer.mark("draft_layers")
+        if self._mode_attn_check and p is self._profiles[0]:
+            self._check_mode_attention(
+                p=p,
+                batch=batch,
+                draft_input=draft_input,
+                block_ids=block_ids,
+                block_positions=block_positions,
+                kv_loc_plan=kv_loc_plan,
+            )
+        if not (self._draft_sampler is not None and draft_out.can_run_graph):
+            hidden = draft_out.logits_output.hidden_states
+            p.topk_head(hidden[: bs * p.draft_width])
+        top_logp, top_ids = p.topk_head.outputs(bs)
+        if timer is not None:
+            timer.mark("draft")
+
+        if self._async and batch.seq_lens_cpu is not None:
+            # The committed lengths are host-known (the overlap scheduler resolves them
+            # from the published lengths), so the round needs no sync.
+            if self._check_host_lens:
+                assert batch.seq_lens_cpu.tolist() == prefix_lens.tolist(), (
+                    batch.seq_lens_cpu.tolist(),
+                    prefix_lens.tolist(),
+                )
+            tree, mask_offsets, prefix_lens_cpu = self._enqueue_trees(
+                p=p,
+                bs=bs,
+                top_logp=top_logp,
+                top_ids=top_ids,
+                prefix_lens_cpu=[int(p) for p in batch.seq_lens_cpu.tolist()],
+            )
+        else:
+            tree, mask_offsets, prefix_lens_cpu = self._build_trees(
+                p=p, bs=bs, top_logp=top_logp, top_ids=top_ids, prefix_lens=prefix_lens
+            )
+        tokens, depths, parents = tree[:, 0], tree[:, 1], tree[:, 2]
+
+        mask_numel = sum(W * (p + W) for p in prefix_lens_cpu)
+        custom_mask = torch.empty((mask_numel,), dtype=torch.bool, device=device)
+        verify_ids = torch.empty((bs, W), dtype=torch.long, device=device)
+        verify_positions = torch.empty((bs, W), dtype=torch.int64, device=device)
+        ddtree_verify_inputs(
+            root_tokens=draft_input.bonus_tokens,
+            prefix_lens=prefix_lens,
+            tokens=tokens,
+            depths=depths,
+            parents=parents,
+            mask_offsets=mask_offsets,
+            ids_out=verify_ids,
+            positions_out=verify_positions,
+            mask_out=custom_mask,
+            max_depth=L - 1,
+        )
+        if timer is not None:
+            timer.mark("verify_start")
+            verify_launch_start = time.perf_counter()
+
+        target_out = self._run_tree_verify(
+            p=p,
+            batch=batch,
+            draft_input=draft_input,
+            verify_ids=verify_ids,
+            verify_positions=verify_positions,
+            custom_mask=custom_mask,
+            window=window,
+            kv_loc_plan=kv_loc_plan,
+        )
+        if timer is not None:
+            timer.mark("verify_end")
+            timer.cpu("cpu_verify_launch", time.perf_counter() - verify_launch_start)
+        logits_output = target_out.logits_output
+        sampling_info = batch.sampling_info
+        if sampling_info is not None:
+            apply_dflash_verify_logits_adjustments(
+                next_token_logits=logits_output.next_token_logits,
+                sampling_info=sampling_info,
+                draft_token_num=W,
+            )
+        posterior = self._target_tokens(
+            logits=logits_output.next_token_logits,
+            sampling_info=sampling_info,
+            bs=bs,
+            width=W,
+            positions=verify_positions,
+        )
+
+        target_window = (
+            kv_loc_plan.write_ids(self.target_worker.model_runner.kv_index_translator)
+            .view(bs, WW)[:, :W]
+            .contiguous()
+        )
+        commit = self._follow_and_commit(
+            posterior=posterior,
+            verify_ids=verify_ids,
+            parents=parents,
+            target_window=target_window,
+            prefix_lens=prefix_lens,
+        )
+        if on_publish is not None:
+            on_publish(commit["new_seq_lens"])
+        if self._trace_path:
+            self._trace_round(
+                prefix_lens=prefix_lens,
+                verify_ids=verify_ids,
+                parents=parents,
+                posterior=posterior,
+                logits=logits_output.next_token_logits,
+                commit=commit,
+            )
+
+        hidden = logits_output.hidden_states
+        if hidden is None:
+            raise RuntimeError("DDTree verify requires target hidden states.")
+        path_hidden = hidden.index_select(0, commit["hidden_index"].reshape(-1))
+        draft_window = (
+            self._draft_write_ids(kv_loc_plan).view(bs, WW)[:, :L].contiguous()
+        )
+        self._append_target_hidden_to_draft_kv_by_loc(
+            target_hidden=path_hidden,
+            cache_loc=draft_window.reshape(-1),
+            cache_loc_2d=draft_window,
+            positions=block_positions.reshape(-1),
+            commit_lens=commit["commit_lens"],
+        )
+        logits_output.hidden_states = None
+        if timer is not None:
+            timer.end_round()
+
+        next_draft_input = self._make_next_draft_input_decode(
+            bonus_tokens=commit["bonus_tokens"], new_seq_lens=commit["new_seq_lens"]
+        )
+        return GenerationBatchResult(
+            logits_output=logits_output,
+            next_token_ids=commit["out_tokens"].reshape(-1),
+            accept_lens=commit["commit_lens"],
+            can_run_cuda_graph=target_out.can_run_cuda_graph,
+            next_draft_input=next_draft_input,
+            speculative_num_draft_tokens=W,
+            speculative_output_stride=L,
+            new_seq_lens=commit["new_seq_lens"],
+            routed_experts_output=target_out.routed_experts_output,
+            indexer_topk_output=target_out.indexer_topk_output,
+        )
+
+    # ------------------------------------------------------------------ steps
+
+    def _check_mode_attention(self, *, p, batch, draft_input, block_ids, block_positions, kv_loc_plan):
+        """Debug (eager): the multi-mode draft logits with each attention implementation vs the
+        float32 reference; logs mean |logit diff| and argmax agreement every 50 rounds."""
+        bs, L = block_ids.shape
+        weight = unwrap_lora_layer(self.target_worker.model_runner.model.lm_head).weight
+        logits = {}
+        for impl in ("reference", "triton", "flashinfer"):
+            out = self._run_draft_blocks(
+                p=p,
+                batch=batch,
+                draft_input=draft_input,
+                block_ids=block_ids,
+                block_positions=block_positions,
+                kv_loc_plan=kv_loc_plan,
+                impl=impl,
+            )
+            if out.can_run_graph:
+                raise RuntimeError("The mode-attention check needs --disable-cuda-graph.")
+            hidden = out.logits_output.hidden_states[: bs * p.draft_width]
+            hs = hidden.view(bs * p.num_modes, L, -1)[:, 1:].reshape(-1, hidden.shape[-1])
+            logits[impl] = torch.matmul(hs.to(weight.dtype), weight.T).float()
+        ref = logits["reference"]
+        ref_arg = ref.argmax(-1)
+        if self._mode_attn_check_stats is None:
+            self._mode_attn_check_stats = {"rounds": 0, "rows": 0}
+        st = self._mode_attn_check_stats
+        st["rounds"] += 1
+        st["rows"] += ref.shape[0]
+        for impl in ("triton", "flashinfer"):
+            diff = (logits[impl] - ref).abs()
+            st[f"{impl}_mean_abs"] = st.get(f"{impl}_mean_abs", 0.0) + float(diff.mean()) * ref.shape[0]
+            st[f"{impl}_max_abs"] = max(st.get(f"{impl}_max_abs", 0.0), float(diff.max()))
+            st[f"{impl}_argmax_same"] = st.get(f"{impl}_argmax_same", 0) + int(
+                (logits[impl].argmax(-1) == ref_arg).sum()
+            )
+        if st["rounds"] % 50 == 0:
+            rows = st["rows"]
+            logger.warning(
+                "DDTree mode-attention check over %d rounds (%d draft positions) vs float32 reference: "
+                "triton mean|dlogit| %.4f max %.3f argmax agree %.4f; flashinfer mean|dlogit| %.4f max %.3f "
+                "argmax agree %.4f",
+                st["rounds"], rows,
+                st["triton_mean_abs"] / rows, st["triton_max_abs"], st["triton_argmax_same"] / rows,
+                st["flashinfer_mean_abs"] / rows, st["flashinfer_max_abs"], st["flashinfer_argmax_same"] / rows,
+            )
+
+    def _run_draft_blocks(
+        self, *, p, batch, draft_input, block_ids, block_positions, kv_loc_plan, impl=None
+    ):
+        bs, L = block_ids.shape
+        K, KL = p.num_modes, p.draft_width
+        target_model = self.target_worker.model_runner.model
+        embed_module = unwrap_lora_layer(
+            _resolve_dflash_embedding_module(self.draft_model, target_model)
+        )
+        noise_embedding = embed_module(block_ids)
+        if self._noise_embed_scale != 1.0:
+            noise_embedding = noise_embedding * self._noise_embed_scale
+        positions = block_positions
+        spec_info = p.draft_block_spec_info
+        mode_embed = self._mode_embeddings(p)
+        if mode_embed is not None:
+            # Mode k's block: the shared block embedding + mode embedding k, at the
+            # same positions; the draft mask keeps the K blocks apart.
+            mode_embed = mode_embed.to(noise_embedding.dtype)
+            noise_embedding = noise_embedding.unsqueeze(1) + mode_embed[None, :, None, :]
+        mode_attention = None
+        if K > 1:
+            positions = block_positions.repeat(1, K)
+            mode_attention = p.mode_attention
+            if impl is not None:
+                mode_attention = self._mode_attention_for_check(p, impl)
+            if mode_attention is None:
+                # flashinfer: the paged prefill kernel with a block-diagonal custom mask
+                spec_info = self._mode_block_spec_info(
+                    p=p,
+                    bs=bs,
+                    prefix_lens=batch.seq_lens,
+                    prefix_lens_bound_cpu=(
+                        batch.seq_lens_cpu
+                        if batch.seq_lens_cpu is not None
+                        else draft_input.nxt_kv_lens_cpu
+                    ),
+                )
+        self._set_mode_attention(mode_attention)
+        input_embeds = noise_embedding.reshape(bs * KL, -1)
+
+        # Host bound of the draft's kv lengths: committed prefix + the draft blocks.
+        if batch.seq_lens_cpu is not None:
+            seq_lens_cpu = batch.seq_lens_cpu.to(torch.int32) + KL
+        elif draft_input.nxt_kv_lens_cpu is not None:
+            seq_lens_cpu = draft_input.nxt_kv_lens_cpu.clone()
+        else:
+            seq_lens_cpu = torch.tensor(
+                [req.kv.kv_allocated_len for req in batch.reqs], dtype=torch.int32
+            )
+        forward_batch = ForwardBatch(
+            forward_mode=ForwardMode.TARGET_VERIFY,
+            batch_size=bs,
+            input_ids=block_ids.repeat(1, K).reshape(-1),
+            req_pool_indices=batch.req_pool_indices,
+            seq_lens=batch.seq_lens,
+            out_cache_loc=None,
+            seq_lens_sum=int(seq_lens_cpu.sum()),
+            seq_lens_cpu=seq_lens_cpu,
+            positions=positions.reshape(-1),
+            input_embeds=input_embeds,
+            spec_algorithm=SpeculativeAlgorithm.DFLASH,
+            spec_info=spec_info,
+            capture_hidden_mode=CaptureHiddenMode.NULL,
+            num_token_non_padded=(
+                torch.tensor(bs * KL, dtype=torch.int32, device=self.device)
+                if enable_num_token_non_padded()
+                else None
+            ),
+            global_num_token_non_padded_cpu=bs * KL,
+        )
+        # The draft blocks write the first K * L columns of the round's window.
+        kv_loc_plan.bind(
+            forward_batch, self.draft_model_runner.kv_index_translator, cols=slice(0, KL)
+        )
+        if self._timer is not None:
+            self._timer.mark("draft_fwd")
+        with torch.inference_mode(), draft_tp_context(self.draft_owns_attention):
+            return self.draft_model_runner.forward(forward_batch)
+
+    def _mode_embeddings(self, p: _Profile):
+        """[num_modes, H] mode embeddings of the draft blocks; None for a single-mode draft or its default path."""
+        embed = self.draft_model.mode_embed
+        if embed is None or not p.mode_subset:
+            return embed
+        if p.mode_subset == (self.draft_model.num_modes,):
+            return None
+        if p.mode_embed is None:  # weights are loaded by the first decode round
+            # the default path, if named, is a zero mode vector
+            rows = torch.cat([embed, torch.zeros_like(embed[:1])])
+            p.mode_embed = rows[list(p.mode_subset)].clone()
+        return p.mode_embed
+
+    def _mode_attention_for_check(self, p: _Profile, impl: str):
+        if impl == "flashinfer":
+            return None
+        cache = self.__dict__.setdefault("_mode_attention_check_objs", {})
+        if (impl, p.num_modes) not in cache:
+            cache[(impl, p.num_modes)] = self._new_mode_attention(impl=impl, num_modes=p.num_modes)
+        return cache[(impl, p.num_modes)]
+
+    def _mode_block_spec_info(
+        self, *, p, bs, prefix_lens, prefix_lens_bound_cpu
+    ) -> DFlashVerifyInput:
+        """Draft spec info of a multi-mode round: block-diagonal mask among the K blocks."""
+        KL = p.draft_width
+        # Exact per-request offsets on the device; the buffer is sized from a host
+        # upper bound of the committed lengths, so no sync (flashinfer reads only the
+        # rows its mask indptr names).
+        sizes = KL * (prefix_lens.to(torch.int64) + KL)
+        offsets = torch.cumsum(sizes, dim=0) - sizes
+        if prefix_lens_bound_cpu is None:
+            prefix_lens_bound_cpu = prefix_lens.cpu()
+        numel = KL * (int(prefix_lens_bound_cpu.sum()) + bs * KL)
+        mask = torch.empty((numel,), dtype=torch.bool, device=self.device)
+        ddtree_mode_mask(
+            prefix_lens=prefix_lens,
+            mask_offsets=offsets,
+            mask_out=mask,
+            num_modes=p.num_modes,
+            block_size=self.block_size,
+        )
+        return DFlashVerifyInput(
+            draft_token=torch.empty((0,), dtype=torch.long, device=self.device),
+            positions=torch.empty((0,), dtype=torch.int64, device=self.device),
+            draft_token_num=KL,
+            custom_mask=mask,
+            capture_hidden_mode=CaptureHiddenMode.NULL,
+        )
+
+    def _build_trees(self, *, p, bs, top_logp, top_ids, prefix_lens):
+        W = p.verify_width
+        host = self._host_buffers(p, bs)
+        host.top_logp[:bs].copy_(top_logp, non_blocking=True)
+        host.top_ids[:bs].copy_(top_ids, non_blocking=True)
+        # The committed lengths ride along with the candidates (same sync).
+        host.prefix_lens[:bs].copy_(prefix_lens, non_blocking=True)
+        host.ready.record()
+        wait_start = time.perf_counter()
+        host.ready.synchronize()
+        build_start = time.perf_counter()
+        tree = host.tree[:bs]
+        build_trees_cpu(
+            top_log_probs=host.top_logp[:bs],
+            top_ids=host.top_ids[:bs],
+            log_prior=host.log_prior[:bs],
+            bs=bs,
+            budget=p.budget,
+            tree=tree,
+            counts=host.counts[:bs],
+        )
+        if self._timer is not None:
+            self._timer.cpu("cpu_wait_draft", build_start - wait_start)
+            self._timer.cpu("cpu_tree_build", time.perf_counter() - build_start)
+            self._timer.collect()
+        prefix_lens_cpu = [int(p) for p in host.prefix_lens[:bs].tolist()]
+        offset = 0
+        for b, p in enumerate(prefix_lens_cpu):
+            host.mask_offsets[b] = offset
+            offset += W * (p + W)
+        tree_gpu = tree.to(self.device, non_blocking=True)
+        offsets_gpu = host.mask_offsets[:bs].to(self.device, non_blocking=True)
+        return tree_gpu, offsets_gpu, prefix_lens_cpu
+
+    def _enqueue_trees(self, *, p, bs, top_logp, top_ids, prefix_lens_cpu):
+        """Stream-ordered tree build: D2H of the candidates, the host builder as a CUDA
+        host function, H2D of the trees; the scheduler thread does not wait."""
+        W = p.verify_width
+        host = self._host_buffers(p, bs)
+        host.top_logp[:bs].copy_(top_logp, non_blocking=True)
+        host.top_ids[:bs].copy_(top_ids, non_blocking=True)
+        build = (
+            self._build_thread.submit
+            if self._build_thread is not None
+            else enqueue_build_trees
+        )
+        build(
+            top_log_probs=host.top_logp[:bs],
+            top_ids=host.top_ids[:bs],
+            log_prior=host.log_prior[:bs],
+            bs=bs,
+            budget=p.budget,
+            tree=host.tree[:bs],
+            counts=host.counts[:bs],
+        )
+        tree_gpu = host.tree[:bs].to(self.device, non_blocking=True)
+        offsets, offset = [], 0
+        for p in prefix_lens_cpu:
+            offsets.append(offset)
+            offset += W * (p + W)
+        offsets_gpu = torch.tensor(offsets, dtype=torch.int64, pin_memory=True).to(
+            self.device, non_blocking=True
+        )
+        return tree_gpu, offsets_gpu, prefix_lens_cpu
+
+    def _run_tree_verify(
+        self,
+        *,
+        p,
+        batch,
+        draft_input,
+        verify_ids,
+        verify_positions,
+        custom_mask,
+        window,
+        kv_loc_plan,
+    ):
+        W, WW = p.verify_width, p.window_width
+        verify_input = DFlashVerifyInput(
+            draft_token=verify_ids.reshape(-1),
+            positions=verify_positions.reshape(-1),
+            draft_token_num=W,
+            custom_mask=custom_mask,
+            capture_hidden_mode=CaptureHiddenMode.FULL,
+            kv_loc_plan=kv_loc_plan,
+            kv_loc_cols=slice(0, W) if WW > W else None,
+        )
+        batch.out_cache_loc = window[:, :W].reshape(-1)
+        seq_lens_cpu_backup = batch.seq_lens_cpu
+        seq_lens_sum_backup = batch.seq_lens_sum
+        if seq_lens_cpu_backup is not None:
+            verify_host_seq_lens = seq_lens_cpu_backup + W
+            batch.seq_lens_cpu = verify_host_seq_lens
+            batch.seq_lens_sum = int(verify_host_seq_lens.sum())
+        elif draft_input.nxt_kv_lens_cpu is not None:
+            batch.seq_lens_cpu = draft_input.nxt_kv_lens_cpu
+            batch.seq_lens_sum = int(draft_input.nxt_kv_lens_sum)
+        verify_forward_batch, _ = verify_input.prepare_for_verify(
+            batch, self.target_worker
+        )
+        batch.seq_lens_cpu = seq_lens_cpu_backup
+        batch.seq_lens_sum = seq_lens_sum_backup
+        return self.target_worker.forward_batch_generation(
+            batch=None,
+            forward_batch=verify_forward_batch,
+            is_verify=True,
+            skip_attn_backend_init=True,
+        )
+
+    def _target_tokens(self, *, logits, sampling_info, bs, width, positions):
+        """The target's token at every tree node: argmax, or one independent
+        sample per node from its (temperature/top-k/top-p/min-p) distribution."""
+        W = width
+        if sampling_info is None or sampling_info.is_all_greedy:
+            return torch.argmax(logits, dim=-1).view(bs, W)
+        temperatures = sampling_info.temperatures.repeat_interleave(W, dim=0)
+        probs = torch.softmax(logits.float() / temperatures, dim=-1)
+        if not (
+            sampling_info.need_top_k_sampling
+            or sampling_info.need_top_p_sampling
+            or sampling_info.need_min_p_sampling
+        ):
+            # Pure temperature sampling: no filtering, so no [W, V] sort.
+            return sampling_from_probs_torch(probs).to(torch.int64).view(bs, W)
+        sampled = top_k_top_p_min_p_sampling_from_probs_torch(
+            probs,
+            sampling_info.top_ks.repeat_interleave(W),
+            sampling_info.top_ps.repeat_interleave(W),
+            sampling_info.min_ps.repeat_interleave(W),
+            sampling_info.need_min_p_sampling,
+            None,
+            positions.reshape(-1),
+        )
+        return sampled.to(torch.int64).view(bs, W)
+
+    def _trace_round(self, *, prefix_lens, verify_ids, parents, posterior, logits, commit):
+        """Debug dump of one round (SGLANG_DFLASH_DDTREE_TRACE); syncs."""
+        import json
+
+        bs, W = verify_ids.shape
+        logp = torch.log_softmax(logits.float(), dim=-1).view(bs, W, -1)
+        top_lp, top_ids = logp.topk(5, dim=-1)
+        rows = []
+        for b in range(bs):
+            n = int(commit["num_correct_drafts"][b])
+            path = (commit["hidden_index"][b, : n + 1] - b * W).tolist()
+            post = posterior[b].tolist()
+            rows.append(
+                {
+                    "prefix_len": int(prefix_lens[b]),
+                    "verify_ids": verify_ids[b].tolist(),
+                    "parents": parents[b].tolist(),
+                    "posterior": post,
+                    "path": path,
+                    "out_tokens": commit["out_tokens"][b, : n + 1].tolist(),
+                    "path_top_ids": top_ids[b, path].tolist(),
+                    "path_top_logp": top_lp[b, path].tolist(),
+                    "path_emitted_logp": [float(logp[b, j, post[j]]) for j in path],
+                }
+            )
+        with open(self._trace_path, "a") as f:
+            for row in rows:
+                f.write(json.dumps(row) + "\n")
+
+    def _follow_and_commit(
+        self, *, posterior, verify_ids, parents, target_window, prefix_lens
+    ):
+        bs, W = verify_ids.shape
+        L = int(self.block_size)
+        device = verify_ids.device
+        out = dict(
+            num_correct_drafts=torch.empty((bs,), dtype=torch.int32, device=device),
+            commit_lens=torch.empty((bs,), dtype=torch.int32, device=device),
+            bonus_tokens=torch.empty((bs,), dtype=torch.int64, device=device),
+            out_tokens=torch.empty((bs, L), dtype=torch.int64, device=device),
+            new_seq_lens=torch.empty((bs,), dtype=torch.int64, device=device),
+            move_src=torch.empty((bs, L), dtype=torch.int64, device=device),
+            move_tgt=torch.empty((bs, L), dtype=torch.int64, device=device),
+            hidden_index=torch.empty((bs, L), dtype=torch.int64, device=device),
+        )
+        ddtree_follow(
+            posterior=posterior,
+            verify_ids=verify_ids,
+            parents=parents,
+            window=target_window,
+            prefix_lens=prefix_lens,
