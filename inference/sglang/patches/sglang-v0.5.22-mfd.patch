diff --git a/python/sglang/srt/speculative/ddtree_async.py b/python/sglang/srt/speculative/ddtree_async.py
new file mode 100644
index 0000000..f806037
--- /dev/null
+++ b/python/sglang/srt/speculative/ddtree_async.py
@@ -0,0 +1,329 @@
+"""Sync-free pieces of a DDTree round (MFD / DDTree patch; see ddtree_utils).
+
+* ``enqueue_build_trees``: the host tree build of ddtree_utils, run as a CUDA host function
+  (cudaLaunchHostFunc) in stream order between the device-to-host copy of the draft's top-k
+  candidates and the host-to-device copy of the trees, so the scheduler thread never waits on
+  the GPU; the builder is the same C++ code (same trees, node for node). Host functions wake up
+  slowly (~0.4 ms per round measured), hence:
+* ``TreeBuildThread``: the same build on a dedicated C++ thread that waits for the candidates'
+  copy event and then writes a pinned flag; the stream waits for that flag
+  (``cuStreamWaitValue32``) before copying the trees in, so the GPU idles only for the build.
+* ``pack_mask_bits``: flashinfer's packed custom-mask layout (per request segment, row-major
+  [q_len x kv_len] bits, little bit order, segments at byte offsets) written from the bool mask
+  at host-known offsets, which is what ``segment_packbits`` produces without its host sync.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.speculative import ddtree_utils
+
+_MODULE = None
+
+
+def _builder_source() -> str:
+    """The C++ builders of ddtree_utils (everything before its batch entry point)."""
+    src = ddtree_utils._CPP_SOURCE
+    start = src.index("namespace {")
+    end = src.index("// top_log_probs: [bs, K, L, k] float32")
+    return src[start:end]
+
+
+_ASYNC_SOURCE_TEMPLATE = r"""
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAException.h>
+#include <cuda_runtime_api.h>
+#include <atomic>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <queue>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+__BUILDERS__
+
+namespace {
+
+struct BuildArgs {
+    const float* lp;
+    const int32_t* ids;
+    const float* prior;
+    int64_t bs, num_modes, depth_limit, topk, budget;
+    int64_t* tree;    // [bs, 3, budget + 1]
+    int64_t* counts;  // [bs]
+};
+
+void CUDART_CB build_trees_host_fn(void* user) {
+    BuildArgs* a = static_cast<BuildArgs*>(user);
+    const int64_t width = a->budget + 1;
+    const int64_t per_req = a->num_modes * a->depth_limit * a->topk;
+    for (int64_t b = 0; b < a->bs; ++b) {
+        int64_t* t = a->tree + b * 3 * width;
+        int64_t* d = t + width;
+        int64_t* p = d + width;
+        int64_t n;
+        if (a->num_modes == 1) {
+            n = build_single_one(a->lp + b * per_req, a->ids + b * per_req, a->depth_limit, a->topk, a->budget, t, d, p);
+        } else {
+            n = build_mixture_one(a->lp + b * per_req, a->ids + b * per_req, a->prior + b * a->num_modes, a->num_modes,
+                                  a->depth_limit, a->topk, a->budget, t, d, p);
+        }
+        t[0] = 0;
+        for (int64_t i = n + 1; i < width; ++i) { t[i] = 0; d[i] = 0; p[i] = -1; }
+        a->counts[b] = n;
+    }
+    delete a;
+}
+
+}  // namespace
+
+struct ThreadJob {
+    cudaEvent_t ready;  // recorded after the candidates' device-to-host copy
+    BuildArgs args;
+    volatile uint32_t* flag;  // pinned; the stream waits until *flag >= seq
+    uint32_t seq;
+};
+
+class BuildThread {
+  public:
+    explicit BuildThread(int device) : device_(device), worker_([this] { run(); }) {}
+    void submit(const ThreadJob& job) {
+        {
+            std::lock_guard<std::mutex> lock(mu_);
+            jobs_.push_back(job);
+        }
+        cv_.notify_one();
+    }
+
+  private:
+    void run() {
+        cudaSetDevice(device_);
+        while (true) {
+            ThreadJob job;
+            {
+                std::unique_lock<std::mutex> lock(mu_);
+                cv_.wait(lock, [this] { return !jobs_.empty(); });
+                job = jobs_.front();
+                jobs_.pop_front();
+            }
+            cudaEventSynchronize(job.ready);
+            BuildArgs* a = new BuildArgs(job.args);
+            build_trees_host_fn(a);  // frees a
+            std::atomic_thread_fence(std::memory_order_seq_cst);
+            *job.flag = job.seq;
+            std::atomic_thread_fence(std::memory_order_seq_cst);
+        }
+    }
+    int device_;
+    std::mutex mu_;
+    std::condition_variable cv_;
+    std::deque<ThreadJob> jobs_;
+    std::thread worker_;
+};
+
+BuildThread* g_thread = nullptr;
+
+// Hand a build to the builder thread (started on first use, never joined). All tensors are pinned
+// host tensors that outlive the round; `event` must stay alive until the build is done.
+void submit_build_trees(int64_t event, torch::Tensor top_log_probs, torch::Tensor top_ids, torch::Tensor log_prior,
+                        int64_t bs, int64_t budget, torch::Tensor tree, torch::Tensor counts, torch::Tensor flag,
+                        int64_t seq, int64_t device) {
+    TORCH_CHECK(top_log_probs.is_contiguous() && top_ids.is_contiguous() && log_prior.is_contiguous());
+    TORCH_CHECK(tree.is_contiguous() && tree.size(1) == 3 && tree.size(2) == budget + 1);
+    if (g_thread == nullptr) g_thread = new BuildThread(static_cast<int>(device));
+    ThreadJob job;
+    job.ready = reinterpret_cast<cudaEvent_t>(event);
+    job.args = BuildArgs{top_log_probs.data_ptr<float>(), top_ids.data_ptr<int32_t>(), log_prior.data_ptr<float>(),
+                         bs, top_log_probs.size(1), top_log_probs.size(2), top_log_probs.size(3), budget,
+                         tree.data_ptr<int64_t>(), counts.data_ptr<int64_t>()};
+    job.flag = reinterpret_cast<volatile uint32_t*>(flag.data_ptr<int32_t>());
+    job.seq = static_cast<uint32_t>(seq);
+    g_thread->submit(job);
+}
+
+// All tensors are pinned host tensors that outlive the stream work; the build runs on a driver
+// thread when the current stream reaches it (after the preceding device-to-host copies).
+void enqueue_build_trees(torch::Tensor top_log_probs, torch::Tensor top_ids, torch::Tensor log_prior, int64_t bs,
+                         int64_t budget, torch::Tensor tree, torch::Tensor counts) {
+    TORCH_CHECK(top_log_probs.is_contiguous() && top_ids.is_contiguous() && log_prior.is_contiguous());
+    TORCH_CHECK(tree.is_contiguous() && tree.size(1) == 3 && tree.size(2) == budget + 1);
+    auto* a = new BuildArgs{top_log_probs.data_ptr<float>(), top_ids.data_ptr<int32_t>(), log_prior.data_ptr<float>(),
+                            bs, top_log_probs.size(1), top_log_probs.size(2), top_log_probs.size(3), budget,
+                            tree.data_ptr<int64_t>(), counts.data_ptr<int64_t>()};
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+    C10_CUDA_CHECK(cudaLaunchHostFunc(stream, build_trees_host_fn, a));
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("enqueue_build_trees", &enqueue_build_trees);
+    m.def("submit_build_trees", &submit_build_trees);
+}
+"""
+
+
+def load_async_module():
+    global _MODULE
+    if _MODULE is None:
+        from torch.utils.cpp_extension import load_inline
+
+        source = _ASYNC_SOURCE_TEMPLATE.replace("__BUILDERS__", _builder_source())
+        _MODULE = load_inline(
+            name="sglang_ddtree_async_v2",
+            cpp_sources=[source],
+            with_cuda=True,
+            extra_cflags=["-O3"],
+            verbose=False,
+        )
+    return _MODULE
+
+
+def enqueue_build_trees(
+    *,
+    top_log_probs: torch.Tensor,
+    top_ids: torch.Tensor,
+    log_prior: torch.Tensor,
+    bs: int,
+    budget: int,
+    tree: torch.Tensor,
+    counts: torch.Tensor,
+) -> None:
+    """Stream-ordered host tree build into pinned ``tree[bs, 3, B + 1]`` (see ddtree_utils)."""
+    load_async_module().enqueue_build_trees(
+        top_log_probs, top_ids, log_prior, bs, budget, tree, counts
+    )
+
+
+class TreeBuildThread:
+    """Tree builds on the C++ builder thread, released to the stream through a pinned flag.
+
+    ``submit`` must be called after the candidates' device-to-host copies were enqueued on the
+    current stream; it records the copy event, hands the build to the thread, and makes the
+    stream wait (cuStreamWaitValue32, >= seq) for the thread's flag before any later work."""
+
+    def __init__(self, device: torch.device):
+        import ctypes
+
+        self.device = device
+        self.flag = torch.zeros(4, dtype=torch.int32, pin_memory=True)
+        self.seq = 0
+        self.events = [torch.cuda.Event() for _ in range(8)]
+        libcuda = ctypes.CDLL("libcuda.so.1")
+        fn = getattr(libcuda, "cuStreamWaitValue32_v2", None) or libcuda.cuStreamWaitValue32
+        fn.argtypes = [ctypes.c_void_p, ctypes.c_uint64, ctypes.c_uint32, ctypes.c_uint]
+        fn.restype = ctypes.c_int
+        self._wait_value = fn
+        self._ctypes = ctypes
+        load_async_module()
+
+    def submit(self, *, top_log_probs, top_ids, log_prior, bs, budget, tree, counts) -> None:
+        self.seq += 1
+        event = self.events[self.seq % len(self.events)]
+        event.record()
+        load_async_module().submit_build_trees(
+            event.cuda_event, top_log_probs, top_ids, log_prior, bs, budget, tree, counts,
+            self.flag, self.seq, self.device.index or 0,
+        )
+        stream = torch.cuda.current_stream()
+        status = self._wait_value(
+            self._ctypes.c_void_p(stream.cuda_stream),
+            self._ctypes.c_uint64(self.flag.data_ptr()),
+            self.seq,
+            0,  # CU_STREAM_WAIT_VALUE_GEQ
+        )
+        if status != 0:
+            raise RuntimeError(f"cuStreamWaitValue32 failed with CUresult {status}")
+
+
+@triton.jit
+def _pack_mask_kernel(
+    mask_ptr,
+    elem_off_ptr,
+    elem_len_ptr,
+    byte_off_ptr,
+    out_ptr,
+    BLOCK: tl.constexpr,
+):
+    b = tl.program_id(0)
+    chunk = tl.program_id(1)
+    elem_off = tl.load(elem_off_ptr + b)
+    elem_len = tl.load(elem_len_ptr + b)
+    byte_off = tl.load(byte_off_ptr + b)
+    num_bytes = (elem_len + 7) // 8
+    byte = chunk * BLOCK + tl.arange(0, BLOCK)
+    valid = byte < num_bytes
+    acc = tl.zeros([BLOCK], tl.int32)
+    for bit in tl.static_range(8):
+        e = byte.to(tl.int64) * 8 + bit
+        m = tl.load(mask_ptr + elem_off + e, mask=valid & (e < elem_len), other=0)
+        acc = acc | ((m != 0).to(tl.int32) << bit)
+    tl.store(out_ptr + byte_off + byte, acc.to(tl.uint8), mask=valid)
+
+
+def pack_mask_bits(
+    *,
+    mask: torch.Tensor,
+    elem_offsets: torch.Tensor,
+    elem_lens: torch.Tensor,
+    byte_offsets: torch.Tensor,
+    out: torch.Tensor,
+    max_bytes: int,
+) -> None:
+    """Pack each request's bool mask segment into ``out`` at its byte offset (little bit order).
+    The offsets/lengths are device int64 tensors [bs]; ``max_bytes`` bounds the longest segment."""
+    bs = int(elem_offsets.numel())
+    if bs == 0 or max_bytes <= 0:
+        return
+    BLOCK = 1024
+    _pack_mask_kernel[(bs, triton.cdiv(max_bytes, BLOCK))](
+        mask.view(torch.int8),
+        elem_offsets,
+        elem_lens,
+        byte_offsets,
+        out,
+        BLOCK=BLOCK,
+        num_warps=4,
+    )
+
+
+def fill_packed_custom_mask(
+    *,
+    custom_mask_buf: torch.Tensor,
+    mask_indptr_buf: torch.Tensor,
+    custom_mask: torch.Tensor,
+    q_len: int,
+    kv_lens_host: torch.Tensor,
+) -> None:
+    """Write flashinfer's packed custom mask and its byte indptr for a batch whose
+    every request has ``q_len`` queries and ``kv_lens_host[i]`` keys (host-known), from
+    the flat bool mask (row-major [q_len x kv_len] per request), without a host sync."""
+    bs = int(kv_lens_host.numel())
+    elem_lens = kv_lens_host.to(torch.int64) * int(q_len)
+    byte_lens = (elem_lens + 7) // 8
+    elem_offsets = torch.cumsum(elem_lens, 0) - elem_lens
+    byte_indptr = torch.zeros(bs + 1, dtype=torch.int64)
+    byte_indptr[1:] = torch.cumsum(byte_lens, 0)
+    host = torch.stack([elem_offsets, elem_lens, byte_indptr[:-1]]).pin_memory()
+    dev = host.to(custom_mask.device, non_blocking=True)
+    mask_indptr_buf[: bs + 1].copy_(
+        byte_indptr.to(mask_indptr_buf.dtype).pin_memory(), non_blocking=True
+    )
+    total = int(elem_lens.sum())
+    if custom_mask.numel() < total:
+        raise ValueError(
+            f"DDTree custom mask has {custom_mask.numel()} entries, the batch needs {total}."
+        )
+    pack_mask_bits(
+        mask=custom_mask,
+        elem_offsets=dev[0],
+        elem_lens=dev[1],
+        byte_offsets=dev[2],
+        out=custom_mask_buf,
+        max_bytes=int(byte_lens.max()),
+    )
diff --git a/python/sglang/srt/speculative/ddtree_mode_attention.py b/python/sglang/srt/speculative/ddtree_mode_attention.py
new file mode 100644
index 0000000..14e51ee
--- /dev/null
+++ b/python/sglang/srt/speculative/ddtree_mode_attention.py
@@ -0,0 +1,428 @@
+"""Attention of a multi-mode (MFD) DFlash draft step without a mask (MFD / DDTree patch).
+
+The K mode blocks of a request sit side by side (K x block_size queries, mode-major); every query attends to the
+request's whole context (the draft KV cache, read through ``req_to_token``) and to the block_size keys of its own
+mode block (taken straight from this step's projected k/v, never written to the cache). Two Triton kernels: the
+split kernel, a port of the MFD release's inference/hf/mode_attention.py (flash-decoding over the context + one split
+for the in-block keys, then a log-sum-exp merge) for small batches, and a fused single-pass kernel for large ones
+(one program per KV head, request and mode group over the whole context plus the group's block keys, written out
+directly: no float32 partials, no merge); ``resolve_ctx_splits`` picks between them. Both are CUDA-graph safe: the
+grid has a fixed number of context splits (``num_ctx_splits``), every program derives its chunk from the context
+length read on the device, and empty splits store lse = -inf and contribute nothing to the merge.
+
+Implementations (SGLANG_DFLASH_DDTREE_MODE_ATTN): "triton" (this kernel), "flashinfer" (the paged prefill kernel
+with a block-diagonal custom mask; the worker builds the mask), "reference" (float32 masked attention, the
+ground truth of mode_attention.reference; eager validation only).
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+LOG2E = 1.4426950408889634
+
+
+@triton.jit
+def _paged_mode_attn_split(
+    q_ptr,
+    knew_ptr,
+    vnew_ptr,
+    kc_ptr,
+    vc_ptr,
+    r2t_ptr,
+    rpi_ptr,
+    ctx_ptr,
+    o_ptr,
+    lse_ptr,
+    stride_qt,
+    stride_qh,
+    stride_kt,
+    stride_kh,
+    stride_vt,
+    stride_vh,
+    stride_kct,
+    stride_kch,
+    stride_vct,
+    stride_vch,
+    stride_r2t,
+    num_groups,
+    qk_scale,
+    G: tl.constexpr,
+    BS: tl.constexpr,
+    MPG: tl.constexpr,
+    K_MODES: tl.constexpr,
+    D: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    NUM_CTX_SPLITS: tl.constexpr,
+    MIN_CHUNK: tl.constexpr,
+):
+    kvh = tl.program_id(0)
+    bg = tl.program_id(1)
+    split = tl.program_id(2)
+    b = bg // num_groups
+    grp = bg % num_groups
+    ROWS: tl.constexpr = G * MPG * BS
+    rows = tl.arange(0, ROWS)
+    g = rows // (MPG * BS)  # query head within the KV head's group
+    m_local = (rows // BS) % MPG  # mode within this program's group
+    t = rows % BS  # token within the block
+    q_head = kvh * G + g
+    tok = (b * K_MODES + grp * MPG + m_local) * BS + t
+    d = tl.arange(0, D)
+    q = tl.load(q_ptr + tok[:, None] * stride_qt + q_head[:, None] * stride_qh + d[None, :])
+
+    m_i = tl.full([ROWS], float("-inf"), tl.float32)
+    l_i = tl.zeros([ROWS], tl.float32)
+    acc = tl.zeros([ROWS, D], tl.float32)
+    if split < NUM_CTX_SPLITS:
+        ctx = tl.load(ctx_ptr + b).to(tl.int32)
+        per_split = tl.cdiv(ctx, NUM_CTX_SPLITS)
+        # short contexts fill only the first splits; the rest exit after storing lse = -inf
+        chunk = tl.maximum(tl.maximum(tl.cdiv(per_split, BLOCK_N), 1) * BLOCK_N, MIN_CHUNK)
+        lo = split * chunk
+        hi = tl.minimum(lo + chunk, ctx)
+        row_ptr = r2t_ptr + tl.load(rpi_ptr + b).to(tl.int64) * stride_r2t
+        for start in range(lo, hi, BLOCK_N):
+            n = start + tl.arange(0, BLOCK_N)
+            valid = n < hi
+            slot = tl.load(row_ptr + n, mask=valid, other=0).to(tl.int64)
+            k = tl.load(
+                kc_ptr + slot[:, None] * stride_kct + kvh * stride_kch + d[None, :],
+                mask=valid[:, None],
+                other=0.0,
+            )
+            s = tl.dot(q, tl.trans(k)) * qk_scale
+            s = tl.where(valid[None, :], s, float("-inf"))
+            m_new = tl.maximum(m_i, tl.max(s, 1))
+            alpha = tl.exp2(m_i - m_new)
+            p = tl.exp2(s - m_new[:, None])
+            l_i = l_i * alpha + tl.sum(p, 1)
+            v = tl.load(
+                vc_ptr + slot[:, None] * stride_vct + kvh * stride_vch + d[None, :],
+                mask=valid[:, None],
+                other=0.0,
+            )
+            acc = acc * alpha[:, None] + tl.dot(p.to(v.dtype), v)
+            m_i = m_new
+    else:
+        # The block keys of this program's modes (MPG x BS tokens); a row sees its own mode's.
+        NB: tl.constexpr = MPG * BS
+        j = tl.arange(0, NB)
+        ktok = (b * K_MODES + grp * MPG) * BS + j
+        k = tl.load(knew_ptr + ktok[:, None] * stride_kt + kvh * stride_kh + d[None, :])
+        s = tl.dot(q, tl.trans(k)) * qk_scale
+        s = tl.where(m_local[:, None] == (j // BS)[None, :], s, float("-inf"))
+        m_i = tl.max(s, 1)
+        p = tl.exp2(s - m_i[:, None])
+        l_i = tl.sum(p, 1)
+        v = tl.load(vnew_ptr + ktok[:, None] * stride_vt + kvh * stride_vh + d[None, :])
+        acc = tl.dot(p.to(v.dtype), v)
+    has = l_i > 0
+    out = acc / tl.where(has, l_i, 1.0)[:, None]
+    lse = tl.where(has, m_i + tl.log2(tl.where(has, l_i, 1.0)), float("-inf"))
+    part = (split * tl.num_programs(0) + kvh) * tl.num_programs(1) + bg
+    # an empty split stores only lse = -inf; the merge does not read its output rows
+    tl.store(o_ptr + part * ROWS * D + rows[:, None] * D + d[None, :], out, mask=has[:, None])
+    tl.store(lse_ptr + part * ROWS + rows, lse)
+
+
+@triton.jit
+def _paged_mode_attn_merge(
+    o_part_ptr,
+    lse_ptr,
+    out_ptr,
+    stride_ot,
+    stride_oh,
+    num_kv_heads,
+    num_bg,
+    num_groups,
+    NUM_SPLITS: tl.constexpr,
+    G: tl.constexpr,
+    BS: tl.constexpr,
+    MPG: tl.constexpr,
+    K_MODES: tl.constexpr,
+    D: tl.constexpr,
+    RB: tl.constexpr,
+):
+    kvh = tl.program_id(0)
+    bg = tl.program_id(1)
+    b = bg // num_groups
+    grp = bg % num_groups
+    ROWS: tl.constexpr = G * MPG * BS
+    rows = tl.program_id(2) * RB + tl.arange(0, RB)
+    d = tl.arange(0, D)
+    m = tl.full([RB], float("-inf"), tl.float32)
+    total = tl.zeros([RB], tl.float32)
+    acc = tl.zeros([RB, D], tl.float32)
+    for split in range(NUM_SPLITS):
+        part = (split * num_kv_heads + kvh) * num_bg + bg
+        lse = tl.load(lse_ptr + part * ROWS + rows)
+        live = lse != float("-inf")
+        o = tl.load(o_part_ptr + part * ROWS * D + rows[:, None] * D + d[None, :], mask=live[:, None], other=0.0)
+        m_new = tl.maximum(m, lse)
+        alpha = tl.where(m_new == float("-inf"), 1.0, tl.exp2(m - m_new))
+        w = tl.where(lse == float("-inf"), 0.0, tl.exp2(lse - m_new))
+        total = total * alpha + w
+        acc = acc * alpha[:, None] + w[:, None] * o
+        m = m_new
+    res = acc / total[:, None]
+    g = rows // (MPG * BS)
+    tok = (b * K_MODES + grp * MPG + (rows // BS) % MPG) * BS + rows % BS
+    q_head = kvh * G + g
+    tl.store(
+        out_ptr + tok[:, None] * stride_ot + q_head[:, None] * stride_oh + d[None, :],
+        res.to(out_ptr.dtype.element_ty),
+    )
+
+
+@triton.jit
+def _paged_mode_attn_fused(
+    q_ptr,
+    knew_ptr,
+    vnew_ptr,
+    kc_ptr,
+    vc_ptr,
+    r2t_ptr,
+    rpi_ptr,
+    ctx_ptr,
+    out_ptr,
+    stride_qt,
+    stride_qh,
+    stride_kt,
+    stride_kh,
+    stride_vt,
+    stride_vh,
+    stride_kct,
+    stride_kch,
+    stride_vct,
+    stride_vch,
+    stride_r2t,
+    stride_ot,
+    stride_oh,
+    num_groups,
+    qk_scale,
+    G: tl.constexpr,
+    BS: tl.constexpr,
+    MPG: tl.constexpr,
+    K_MODES: tl.constexpr,
+    D: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+):
+    # One program per (KV head, request, mode group): the whole context, then the group's block keys, written
+    # out directly; no partial buffers and no merge. For batches whose programs fill the GPU (the split kernel
+    # exists for small batches).
+    kvh = tl.program_id(0)
+    bg = tl.program_id(1)
+    b = bg // num_groups
+    grp = bg % num_groups
+    ROWS: tl.constexpr = G * MPG * BS
+    rows = tl.arange(0, ROWS)
+    g = rows // (MPG * BS)
+    m_local = (rows // BS) % MPG
+    t = rows % BS
+    q_head = kvh * G + g
+    tok = (b * K_MODES + grp * MPG + m_local) * BS + t
+    d = tl.arange(0, D)
+    q = tl.load(q_ptr + tok[:, None] * stride_qt + q_head[:, None] * stride_qh + d[None, :])
+
+    m_i = tl.full([ROWS], float("-inf"), tl.float32)
+    l_i = tl.zeros([ROWS], tl.float32)
+    acc = tl.zeros([ROWS, D], tl.float32)
+    ctx = tl.load(ctx_ptr + b).to(tl.int32)
+    row_ptr = r2t_ptr + tl.load(rpi_ptr + b).to(tl.int64) * stride_r2t
+    for start in range(0, ctx, BLOCK_N):
+        n = start + tl.arange(0, BLOCK_N)
+        valid = n < ctx
+        slot = tl.load(row_ptr + n, mask=valid, other=0).to(tl.int64)
+        k = tl.load(
+            kc_ptr + slot[:, None] * stride_kct + kvh * stride_kch + d[None, :],
+            mask=valid[:, None],
+            other=0.0,
+        )
+        s = tl.dot(q, tl.trans(k)) * qk_scale
+        s = tl.where(valid[None, :], s, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(s, 1))
+        alpha = tl.exp2(m_i - m_new)
+        p = tl.exp2(s - m_new[:, None])
+        l_i = l_i * alpha + tl.sum(p, 1)
+        v = tl.load(
+            vc_ptr + slot[:, None] * stride_vct + kvh * stride_vch + d[None, :],
+            mask=valid[:, None],
+            other=0.0,
+        )
+        acc = acc * alpha[:, None] + tl.dot(p.to(v.dtype), v)
+        m_i = m_new
+    NB: tl.constexpr = MPG * BS
+    j = tl.arange(0, NB)
+    ktok = (b * K_MODES + grp * MPG) * BS + j
+    k = tl.load(knew_ptr + ktok[:, None] * stride_kt + kvh * stride_kh + d[None, :])
+    s = tl.dot(q, tl.trans(k)) * qk_scale
+    s = tl.where(m_local[:, None] == (j // BS)[None, :], s, float("-inf"))
+    m_new = tl.maximum(m_i, tl.max(s, 1))
+    alpha = tl.exp2(m_i - m_new)
+    p = tl.exp2(s - m_new[:, None])
+    l_i = l_i * alpha + tl.sum(p, 1)
+    v = tl.load(vnew_ptr + ktok[:, None] * stride_vt + kvh * stride_vh + d[None, :])
+    acc = acc * alpha[:, None] + tl.dot(p.to(v.dtype), v)
+    out = acc / l_i[:, None]
+    tl.store(
+        out_ptr + tok[:, None] * stride_ot + q_head[:, None] * stride_oh + d[None, :],
+        out.to(out_ptr.dtype.element_ty),
+    )
+
+
+_SM_COUNT = {}
+
+
+def _sm_count(device) -> int:
+    idx = device.index if device.index is not None else torch.cuda.current_device()
+    if idx not in _SM_COUNT:
+        _SM_COUNT[idx] = torch.cuda.get_device_properties(idx).multi_processor_count
+    return _SM_COUNT[idx]
+
+
+def resolve_ctx_splits(num_ctx_splits: int, *, programs: int, device) -> int:
+    """num_ctx_splits > 0: that many splits (the merge path); 0: the fused single-pass kernel; < 0: auto, fused
+    once the (KV head, request, mode group) programs alone cover the SMs twice, else up to 4 splits."""
+    if num_ctx_splits >= 0:
+        return num_ctx_splits
+    want = 2 * _sm_count(device)
+    if programs >= want:
+        return 0
+    return min(4, max(1, -(-want // programs)))
+
+
+def paged_mode_block_attention(
+    *,
+    q: torch.Tensor,
+    k_new: torch.Tensor,
+    v_new: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    req_to_token: torch.Tensor,
+    req_pool_indices: torch.Tensor,
+    ctx_lens: torch.Tensor,
+    num_modes: int,
+    block_size: int,
+    scaling: float,
+    num_ctx_splits: int,
+    out: Optional[torch.Tensor] = None,
+    modes_per_program: int = 2,
+    block_n: int = 64,
+    min_chunk: int = 64,
+    num_warps: Optional[int] = None,
+) -> torch.Tensor:
+    """q [T, H, D], k_new/v_new [T, Hkv, D] with T = bs * K * block_size (mode-major per request);
+    k_cache/v_cache [slots, Hkv, D]; the context of request b is req_to_token[req_pool_indices[b], :ctx_lens[b]].
+    Returns [T, H, D] (``out`` if given). num_ctx_splits: see resolve_ctx_splits."""
+    T, H, D = q.shape
+    Hkv = k_new.shape[1]
+    KL = num_modes * block_size
+    bs = T // KL
+    assert T == bs * KL and H % Hkv == 0
+    assert q.stride(-1) == 1 and k_new.stride(-1) == 1 and v_new.stride(-1) == 1
+    assert k_cache.stride(-1) == 1 and v_cache.stride(-1) == 1 and req_to_token.stride(1) == 1
+    mpg = modes_per_program if num_modes % modes_per_program == 0 else 1
+    groups = num_modes // mpg
+    G = H // Hkv
+    rows = G * mpg * block_size
+    if out is None:
+        out = torch.empty((T, H, D), device=q.device, dtype=q.dtype)
+    if bs == 0:
+        return out
+    warps = num_warps or (8 if rows >= 128 else 4)
+    num_ctx_splits = resolve_ctx_splits(num_ctx_splits, programs=Hkv * bs * groups, device=q.device)
+    if num_ctx_splits == 0:
+        _paged_mode_attn_fused[(Hkv, bs * groups)](
+            q, k_new, v_new, k_cache, v_cache, req_to_token, req_pool_indices, ctx_lens, out,
+            q.stride(0), q.stride(1), k_new.stride(0), k_new.stride(1), v_new.stride(0), v_new.stride(1),
+            k_cache.stride(0), k_cache.stride(1), v_cache.stride(0), v_cache.stride(1), req_to_token.stride(0),
+            out.stride(0), out.stride(1), groups, scaling * LOG2E,
+            G=G, BS=block_size, MPG=mpg, K_MODES=num_modes, D=D, BLOCK_N=block_n, num_warps=warps, num_stages=2,
+        )
+        return out
+    num_splits = num_ctx_splits + 1
+    o_part = torch.empty((num_splits, Hkv, bs * groups, rows, D), device=q.device, dtype=torch.float32)
+    lse = torch.empty((num_splits, Hkv, bs * groups, rows), device=q.device, dtype=torch.float32)
+    _paged_mode_attn_split[(Hkv, bs * groups, num_splits)](
+        q, k_new, v_new, k_cache, v_cache, req_to_token, req_pool_indices, ctx_lens, o_part, lse,
+        q.stride(0), q.stride(1), k_new.stride(0), k_new.stride(1), v_new.stride(0), v_new.stride(1),
+        k_cache.stride(0), k_cache.stride(1), v_cache.stride(0), v_cache.stride(1), req_to_token.stride(0),
+        groups, scaling * LOG2E,
+        G=G, BS=block_size, MPG=mpg, K_MODES=num_modes, D=D, BLOCK_N=block_n, NUM_CTX_SPLITS=num_ctx_splits,
+        MIN_CHUNK=min_chunk, num_warps=warps, num_stages=2,
+    )
+    rb = 32
+    _paged_mode_attn_merge[(Hkv, bs * groups, rows // rb)](
+        o_part, lse, out, out.stride(0), out.stride(1), Hkv, bs * groups, groups,
+        NUM_SPLITS=num_splits, G=G, BS=block_size, MPG=mpg, K_MODES=num_modes, D=D, RB=rb, num_warps=4,
+    )
+    return out
+
+
+def paged_mode_block_attention_reference(
+    *,
+    q, k_new, v_new, k_cache, v_cache, req_to_token, req_pool_indices, ctx_lens, num_modes, block_size, scaling,
+) -> torch.Tensor:
+    """Float32 masked attention (mode_attention.reference on the gathered context); returns [T, H, D] float32."""
+    T, H, D = q.shape
+    Hkv = k_new.shape[1]
+    KL = num_modes * block_size
+    out = torch.empty((T, H, D), device=q.device, dtype=torch.float32)
+    for b in range(T // KL):
+        ctx = int(ctx_lens[b])
+        slots = req_to_token[int(req_pool_indices[b]), :ctx].long()
+        rows = slice(b * KL, (b + 1) * KL)
+        kk = torch.cat([k_cache[slots], k_new[rows]], 0).float()  # [ctx + KL, Hkv, D]
+        vv = torch.cat([v_cache[slots], v_new[rows]], 0).float()
+        qb = q[rows].float().transpose(0, 1)  # [H, KL, D]
+        kk = kk.transpose(0, 1).repeat_interleave(H // Hkv, dim=0)
+        vv = vv.transpose(0, 1).repeat_interleave(H // Hkv, dim=0)
+        mode = torch.arange(KL, device=q.device) // block_size
+        mask = torch.zeros((KL, ctx + KL), device=q.device)
+        mask[:, ctx:].masked_fill_(mode[:, None] != mode[None, :], float("-inf"))
+        o = torch.nn.functional.scaled_dot_product_attention(qb, kk, vv, attn_mask=mask, scale=scaling)
+        out[rows] = o.transpose(0, 1)
+    return out
+
+
+class PagedModeAttention:
+    """Called by DFlashAttention (``mode_attention`` hook) in place of its RadixAttention for the multi-mode draft
+    forward: q/k/v as [T, heads * D] slices of the fused qkv; returns [T, heads * D]. The step's block keys are not
+    written to the cache (the round's target features overwrite those slots afterwards anyway)."""
+
+    def __init__(self, *, kv_pool, req_to_token, num_modes: int, block_size: int, num_heads: int, num_kv_heads: int,
+                 head_dim: int, scaling: float, num_ctx_splits: int, impl: str):
+        self.kv_pool = kv_pool
+        self.req_to_token = req_to_token
+        self.num_modes = int(num_modes)
+        self.block_size = int(block_size)
+        self.num_heads = int(num_heads)
+        self.num_kv_heads = int(num_kv_heads)
+        self.head_dim = int(head_dim)
+        self.scaling = float(scaling)
+        self.num_ctx_splits = int(num_ctx_splits)
+        assert impl in ("triton", "reference"), impl
+        self.impl = impl
+
+    def __call__(self, q, k, v, forward_batch, layer_id: int) -> torch.Tensor:
+        T = q.shape[0]
+        qh = q.view(T, self.num_heads, self.head_dim)
+        kh = k.view(T, self.num_kv_heads, self.head_dim)
+        vh = v.view(T, self.num_kv_heads, self.head_dim)
+        k_cache, v_cache = self.kv_pool.get_kv_buffer(layer_id)
+        bs = T // (self.num_modes * self.block_size)
+        args = dict(
+            q=qh, k_new=kh, v_new=vh, k_cache=k_cache, v_cache=v_cache, req_to_token=self.req_to_token,
+            req_pool_indices=forward_batch.req_pool_indices[:bs], ctx_lens=forward_batch.seq_lens[:bs],
+            num_modes=self.num_modes, block_size=self.block_size, scaling=self.scaling,
+        )
+        if self.impl == "reference":
+            out = paged_mode_block_attention_reference(**args).to(q.dtype)
+        else:
+            out = paged_mode_block_attention(**args, num_ctx_splits=self.num_ctx_splits)
+        return out.view(T, self.num_heads * self.head_dim)
