+    def _make_kv_move(self):
+        kv_pool = self.model_runner.token_to_kv_pool_allocator.get_kvcache()
+        if DDTreeKVCompactor.supports(kv_pool) and not envs.SGLANG_DFLASH_DDTREE_GENERIC_KV_MOVE.get():
